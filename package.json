{
  "name": "vornac-landing",
  "version": "1.0.0",
  "scripts": {
    "dev": "npm-run-all --parallel dev:css dev:html",
    "dev:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --watch",
    "dev:html": "eleventy --serve --port=8081",
    "build:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --minify",
    "build:html": "eleventy",
    "build": "npm run build:css && npm run build:html",
    "build:de": "VORNAC_LOCALE=de npm run build",
    "dev:de": "VORNAC_LOCALE=de npm run dev",
    "clean": "rm -rf dist",
    "start": "npm run build && python3 serve_local.py"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "autoprefixer": "^10.4.22",
    "baseline-browser-mapping": "^2.9.19",
    "node-html-parser": "^7.1.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19"
  },
  "description": "",
  "main": "postcss.config.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ausdre/vornac.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ausdre/vornac/issues"
  },
  "homepage": "https://github.com/ausdre/vornac#readme"
}
