{# Page-end scripts: cookie consent + mobile nav. One DOMContentLoaded block. #}
<script>
document.addEventListener('DOMContentLoaded', function() {

    // ── Cookie consent ──────────────────────────────────────────────
    const banner = document.getElementById('cookie-banner');
    const acceptBtn = document.getElementById('accept-cookies');
    const declineBtn = document.getElementById('decline-cookies');
    const consentKey = 'vornac_consent_given';

    const activateAds = () => {
        if (typeof gtag === 'function') {
            gtag('consent', 'update', {
                'ad_storage': 'granted',
                'ad_user_data': 'granted',
                'ad_personalization': 'granted'
            });
        }
    };

    if (!localStorage.getItem(consentKey)) {
        setTimeout(() => {
            if (banner) banner.classList.remove('hidden');
        }, 2000);
    } else if (localStorage.getItem(consentKey) === 'true') {
        activateAds();
    }

    acceptBtn?.addEventListener('click', () => {
        localStorage.setItem(consentKey, 'true');
        banner?.classList.add('hidden');
        activateAds();
    });

    declineBtn?.addEventListener('click', () => {
        localStorage.setItem(consentKey, 'false');
        banner?.classList.add('hidden');
    });

    // ── Nav overlay menu (shared by the top + sticky burgers) ──────────
    const toggleBtns = Array.from(document.querySelectorAll('[data-nav-toggle]'));
    const mobileMenu = document.getElementById('mobile-menu');
    const backdrop = document.getElementById('mobile-backdrop');

    if (toggleBtns.length && mobileMenu && backdrop) {
        const setExpanded = (state) => toggleBtns.forEach(b => b.setAttribute('aria-expanded', String(state)));

        const closeMenu = () => {
            mobileMenu.classList.add('hidden');
            backdrop.classList.add('hidden');
            document.body.classList.remove('nav-open');
            setExpanded(false);
        };

        const openMenu = () => {
            mobileMenu.classList.remove('hidden');
            backdrop.classList.remove('hidden');
            document.body.classList.add('nav-open');
            setExpanded(true);
        };

        toggleBtns.forEach(btn => btn.addEventListener('click', (e) => {
            e.stopPropagation();
            mobileMenu.classList.contains('hidden') ? openMenu() : closeMenu();
        }));

        backdrop.addEventListener('click', closeMenu);

        mobileMenu.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', closeMenu);
        });

        document.addEventListener('click', (e) => {
            const insideMenu = mobileMenu.contains(e.target);
            const onButton = toggleBtns.some(b => b.contains(e.target));
            if (!mobileMenu.classList.contains('hidden') && !insideMenu && !onButton) {
                closeMenu();
            }
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !mobileMenu.classList.contains('hidden')) closeMenu();
        });
    }
});
</script>
