{#
  Shared CSS for the homepage (index EN + index DE).

  This is the v-* design system that appears only on the homepage:
    - Hero (.v-hero, .v-hero-headline, .v-amber-mark, …)
    - Light + dark stats bands (.v-stats, .v-stat-number, .v-stat-rule, …)
    - German data sovereignty (.v-sovereignty, .v-sov-mark, …)
    - Trust strip / logo marquee (.v-trust, .v-trust-track, …)
    - Comparison table (.v-comp, .v-comp-table, .v-comp-status--*, …)
    - Polish-pass additions (motion, focus rings, sticky mobile column)

  Includes a "color tokens" :root block and small utilities (.bg-warm*) so
  the homepage works even if shared input.css updates lag behind.

  Each language version of the homepage overlays its own `.v-amber-mark`
  rule on top of this partial — see notes in /index.njk and /de/index.njk.
  The amber-mark behaves differently in EN vs DE because:
    - EN headline phrase is short and single-line, so EN uses a ::after band.
    - DE headline phrase is long and wraps, so DE uses background-image
      gradient with box-decoration-break: clone for per-line bands.
#}
<style>
    :root {
        --color-bg: #ffffff;
        --color-bg-soft: #f5f5f4;
        --color-bg-muted: #e7e5e4;
        --color-accent: #d4a012;
        --color-accent-dark: #b8860b;
        --color-text: #1c1917;
        --color-text-muted: #57534e;

        /* Enterprise tokens (vornac clean white + confident amber) */
        --v-bg:        #ffffff;
        --v-bg-band:   #f5f5f4;
        --v-bg-card:   #ffffff;
        --v-bg-dark:   #0E1116;
        --v-bg-dark-2: #181C24;
        --v-ink:       #0E1116;
        --v-ink-2:     #4B5260;
        --v-ink-3:     #7A8190;
        --v-line:      #e7e5e4;
        --v-line-soft: #f1f0ee;
        --v-line-dark: #2A2F39;
        --v-amber:     #E89615;
        --v-amber-deep:#B4720A;
        --v-amber-soft:#FEF3D8;
        --v-sans: 'Manrope', system-ui, -apple-system, sans-serif;
    }

    .bg-warm { background-color: #ffffff; }
    .bg-warm-soft { background-color: #f5f5f4; }
    .bg-warm-muted { background-color: #e7e5e4; }

    /* Announcement bar */
    .v-announcement {
        background: var(--v-bg-dark);
        color: #fff;
        font-family: var(--v-sans);
        font-size: 13.5px;
        font-weight: 500;
        padding: 11px 0;
        text-align: center;
        position: relative;
        z-index: 60;
        letter-spacing: -0.005em;
    }
    .v-announcement-inner {
        max-width: 1320px;
        margin: 0 auto;
        padding: 0 32px;
    }
    .v-announcement-tag {
        display: inline-block;
        background: var(--v-amber);
        color: var(--v-bg-dark);
        font-size: 10.5px;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 3px 8px;
        margin-right: 14px;
        border-radius: 3px;
        vertical-align: 2px;
    }
    .v-announcement a {
        color: #fff;
        text-decoration: none;
        border-bottom: 1px solid rgba(255,255,255,0.35);
        padding-bottom: 1px;
        margin-left: 8px;
        transition: border-color 0.15s, color 0.15s;
        font-weight: 600;
    }
    .v-announcement a:hover {
        border-bottom-color: var(--v-amber);
        color: var(--v-amber);
    }
    @media (max-width: 640px) {
        .v-announcement { font-size: 12.5px; padding: 10px 0; }
        .v-announcement-inner { padding: 0 20px; }
        .v-announcement a { display: inline-block; margin-left: 4px; }
    }

    /* Hero */
    .v-hero {
        background: var(--v-bg);
        border-bottom: 1px solid var(--v-line);
        font-family: var(--v-sans);
        position: relative;
        z-index: 1;
    }
    .v-hero-inner {
        max-width: 1240px;
        margin: 0 auto;
        padding: 96px 40px 64px;
    }
    .v-hero-kicker {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--v-amber-deep);
        margin-bottom: 28px;
    }
    .v-hero-kicker::before {
        content: '';
        width: 28px;
        height: 1px;
        background: var(--v-amber);
    }
    .v-hero-headline {
        font-family: var(--v-sans);
        font-size: clamp(40px, 5.6vw, 80px);
        line-height: 1.02;
        letter-spacing: -0.035em;
        font-weight: 700;
        color: var(--v-ink);
        margin: 0 0 36px;
        max-width: 22ch;
    }
    /* .v-amber-mark is locale-specific — see each homepage template. */
    .v-hero-subline {
        font-family: var(--v-sans);
        font-size: 19px;
        line-height: 1.55;
        color: var(--v-ink-2);
        max-width: 740px;
        margin: 0 0 48px;
        font-weight: 400;
    }
    .v-hero-actions {
        display: flex;
        align-items: center;
        gap: 28px;
        flex-wrap: wrap;
        margin-bottom: 40px;
    }
    .v-hero-trust {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 14px 18px;
        margin: 0 0 64px;
        padding-top: 24px;
        border-top: 1px solid var(--v-line);
        max-width: 740px;
        font-family: var(--v-sans);
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        line-height: 1.5;
    }
    .v-hero-trust-label {
        color: var(--v-amber-deep);
    }
    .v-hero-trust-list {
        color: var(--v-ink-3);
        font-weight: 600;
        letter-spacing: 0.10em;
    }
    .v-btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 16px 28px;
        background: var(--v-bg-dark);
        color: #fff;
        text-decoration: none;
        font-family: var(--v-sans);
        font-size: 15px;
        font-weight: 600;
        border-radius: 4px;
        transition: background 0.15s, transform 0.15s;
        letter-spacing: -0.005em;
    }
    .v-btn-primary:hover { background: var(--v-amber-deep); }
    .v-btn-primary svg { transition: transform 0.2s ease; }
    .v-btn-primary:hover svg { transform: translateX(3px); }
    .v-btn-ghost {
        color: var(--v-ink);
        text-decoration: none;
        font-family: var(--v-sans);
        font-size: 15px;
        font-weight: 600;
        padding: 6px 0;
        border-bottom: 2px solid var(--v-ink);
        transition: color 0.15s, border-color 0.15s;
        letter-spacing: -0.005em;
    }
    .v-btn-ghost:hover {
        color: var(--v-amber-deep);
        border-bottom-color: var(--v-amber-deep);
    }
    .v-hero-category {
        font-family: var(--v-sans);
        font-size: 15px;
        font-weight: 500;
        color: var(--v-ink-2);
        border-left: 3px solid var(--v-amber);
        padding-left: 18px;
        max-width: 520px;
        line-height: 1.5;
        letter-spacing: -0.003em;
    }
    @media (max-width: 768px) {
        .v-hero-inner { padding: 64px 24px 48px; }
        .v-hero-actions { gap: 20px; margin-bottom: 28px; }
        .v-hero-subline { font-size: 17px; margin-bottom: 36px; }
        .v-hero-kicker { margin-bottom: 22px; font-size: 11px; }
        .v-hero-headline { margin-bottom: 28px; }
        .v-hero-trust { padding-top: 20px; gap: 10px 14px; margin-bottom: 40px; font-size: 10.5px; }
    }

    /* Stats band */
    .v-stats {
        background: var(--v-bg-band);
        border-top: 1px solid var(--v-line);
        border-bottom: 1px solid var(--v-line);
        font-family: var(--v-sans);
        position: relative;
        z-index: 1;
    }
    .v-stats.is-dark {
        background: var(--v-bg-dark);
        border-top: 1px solid var(--v-line-dark);
        border-bottom: 1px solid var(--v-line-dark);
    }
    .v-stats-inner {
        max-width: 1240px;
        margin: 0 auto;
        padding: 96px 40px 112px;
    }
    .v-stats-kicker {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--v-amber-deep);
        margin: 0 0 56px;
    }
    .v-stats-kicker::before {
        content: '';
        width: 28px;
        height: 1px;
        background: var(--v-amber);
    }
    .v-stats.is-dark .v-stats-kicker { color: var(--v-amber); }
    .v-stats-headline {
        font-family: var(--v-sans);
        font-size: clamp(38px, 4.6vw, 64px);
        line-height: 1.04;
        letter-spacing: -0.03em;
        font-weight: 700;
        color: var(--v-ink);
        margin: 0 0 64px;
        max-width: 20ch;
    }
    .v-stats.is-dark .v-stats-headline { color: #fff; }
    .v-stats-divider {
        height: 1px;
        background: var(--v-line);
        margin-bottom: 64px;
    }
    .v-stats.is-dark .v-stats-divider { background: var(--v-line-dark); }
    .v-stats-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 0;
    }
    .v-stats-grid.is-four { grid-template-columns: 1fr 1fr 1fr 1fr; }
    .v-stat { position: relative; padding: 0 56px; }
    .v-stats-grid.is-four .v-stat { padding: 0 32px; }
    .v-stat:first-child { padding-left: 0; }
    .v-stat:last-child  { padding-right: 0; }
    .v-stats-grid.is-four .v-stat-number {
        font-size: clamp(64px, 6.8vw, 108px);
        margin-bottom: 26px;
    }
    .v-stats-grid.is-four .v-stat-rule { width: 64px; margin-bottom: 18px; }
    .v-stats-grid.is-four .v-stat-label { font-size: 16px; max-width: 20ch; }
    .v-stats-grid.is-four .v-stat-prefix { font-size: clamp(16px, 1.5vw, 24px); }
    .v-stats-grid.is-four .v-stat-prefix + .v-stat-num { margin-left: 10px; }
    .v-stat + .v-stat::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 1px;
        background: var(--v-line);
    }
    .v-stats.is-dark .v-stat + .v-stat::before { background: var(--v-line-dark); }
    .v-stat-number {
        font-family: var(--v-sans);
        font-weight: 800;
        font-size: clamp(82px, 9.4vw, 148px);
        line-height: 0.92;
        letter-spacing: -0.055em;
        color: var(--v-ink);
        display: flex;
        align-items: baseline;
        gap: 0;
        margin-bottom: 30px;
        white-space: nowrap;
    }
    .v-stats.is-dark .v-stat-number { color: #fff; }
    .v-stat-num { display: inline-block; }
    .v-stat-prefix + .v-stat-num { margin-left: 14px; }
    .v-stat-prefix {
        font-family: var(--v-sans);
        font-weight: 700;
        font-size: clamp(20px, 1.9vw, 30px);
        letter-spacing: -0.01em;
        color: var(--v-ink-3);
        line-height: 1;
        text-transform: lowercase;
    }
    .v-stat-range {
        font-weight: 700;
        font-size: 0.46em;
        letter-spacing: -0.02em;
        color: rgba(0, 0, 0, 0.32);
        margin-left: 0.02em;
    }
    .v-stats.is-dark .v-stat-range { color: rgba(255, 255, 255, 0.40); }
    .v-stat-unit {
        font-weight: 800;
        font-size: 0.62em;
        margin-left: 0.04em;
        color: var(--v-amber);
    }
    .v-stats.is-dark .v-stat-unit { font-size: 0.5em; margin-left: 0.06em; }
    .v-stat-rule {
        width: 64px;
        height: 2px;
        background: var(--v-ink);
        opacity: 0.85;
        margin-bottom: 22px;
    }
    .v-stats.is-dark .v-stat-rule {
        background: var(--v-amber);
        opacity: 1;
    }
    .v-stat-label {
        font-family: var(--v-sans);
        font-size: 17px;
        font-weight: 600;
        line-height: 1.4;
        color: var(--v-ink);
        letter-spacing: -0.005em;
        max-width: 24ch;
    }
    .v-stats.is-dark .v-stat-label { color: #fff; }
    .v-stat-label .v-stat-label-sub {
        display: block;
        font-weight: 400;
        color: var(--v-ink-2);
        font-size: 13.5px;
        margin-top: 18px;
        letter-spacing: -0.003em;
        line-height: 1.55;
        max-width: 32ch;
    }
    .v-stats.is-dark .v-stat-label .v-stat-label-sub { color: rgba(255, 255, 255, 0.58); }

    @media (max-width: 1024px) {
        .v-stats-inner { padding: 72px 32px 88px; }
        .v-stat { padding: 0 36px; }
        .v-stats-headline { margin-bottom: 48px; }
        .v-stats-divider { margin-bottom: 48px; }
        .v-stats-grid.is-four { grid-template-columns: 1fr 1fr; row-gap: 56px; }
        .v-stats-grid.is-four .v-stat { padding: 0 32px; }
        .v-stats-grid.is-four .v-stat:nth-child(2n+1) { padding-left: 0; }
        .v-stats-grid.is-four .v-stat:nth-child(2n)   { padding-right: 0; }
        .v-stats-grid.is-four .v-stat:nth-child(2n+1)::before { display: none; }
        .v-stats-grid.is-four .v-stat-number { font-size: clamp(72px, 10vw, 120px); }
    }

    /* German data sovereignty */
    .v-sovereignty {
        background: var(--v-bg);
        border-top: 1px solid var(--v-line);
        border-bottom: 1px solid var(--v-line);
        font-family: var(--v-sans);
        position: relative;
        z-index: 1;
    }
    .v-sovereignty-inner {
        max-width: 1240px;
        margin: 0 auto;
        padding: 96px 40px 104px;
    }
    .v-sov-head { max-width: 780px; margin-bottom: 64px; }
    .v-sov-kicker {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--v-amber-deep);
        margin-bottom: 24px;
    }
    .v-sov-kicker::before { content: ''; width: 28px; height: 1px; background: var(--v-amber); }
    .v-sov-headline {
        font-family: var(--v-sans);
        font-size: clamp(34px, 4vw, 56px);
        line-height: 1.06;
        letter-spacing: -0.03em;
        font-weight: 700;
        color: var(--v-ink);
        margin: 0 0 28px;
    }
    .v-sov-headline .v-sov-emph { color: var(--v-amber-deep); }
    .v-sov-subline {
        font-family: var(--v-sans);
        font-size: 17px;
        line-height: 1.6;
        color: var(--v-ink-2);
        margin: 0;
        font-weight: 400;
        max-width: 680px;
    }
    .v-sov-marks {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 20px;
    }
    .v-sov-mark {
        background: var(--v-bg-card);
        border: 1px solid var(--v-line);
        padding: 32px 28px;
        display: flex;
        flex-direction: column;
        min-height: 240px;
        text-decoration: none;
        transition: border-color 0.18s ease, transform 0.18s ease;
        color: var(--v-ink);
        position: relative;
    }
    .v-sov-mark-num {
        position: absolute;
        top: 20px;
        right: 24px;
        font-family: var(--v-sans);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.16em;
        color: var(--v-ink-3);
        line-height: 1;
        pointer-events: none;
    }
    .v-sov-mark--flag .v-sov-mark-num { color: var(--v-amber-deep); }
    a.v-sov-mark:hover .v-sov-mark-num { color: var(--v-amber-deep); }
    a.v-sov-mark:hover { border-color: var(--v-ink); transform: translateY(-2px); }
    .v-sov-mark--flag { justify-content: space-between; }
    .v-sov-mark-flag {
        display: flex;
        height: 6px;
        width: 60px;
        overflow: hidden;
        margin-bottom: 24px;
    }
    .v-sov-mark-flag span { display: block; height: 100%; width: 33.333%; }
    .v-sov-mark-flag span:nth-child(1) { background: #000000; }
    .v-sov-mark-flag span:nth-child(2) { background: #DD0000; }
    .v-sov-mark-flag span:nth-child(3) { background: #FFCC00; }
    .v-sov-mark-title {
        font-family: var(--v-sans);
        font-size: 22px;
        font-weight: 700;
        line-height: 1.22;
        letter-spacing: -0.018em;
        color: var(--v-ink);
        margin: 0 0 14px;
    }
    .v-sov-mark-sub {
        font-family: var(--v-sans);
        font-size: 13.5px;
        font-weight: 500;
        color: var(--v-ink-2);
        line-height: 1.55;
        margin: 0;
    }
    .v-sov-mark--image { align-items: center; justify-content: center; text-align: center; }
    .v-sov-mark--image img {
        max-width: 220px;
        max-height: 120px;
        width: auto;
        height: auto;
        object-fit: contain;
        flex: 1;
        margin-bottom: 18px;
    }
    .v-sov-mark-meta {
        font-family: var(--v-sans);
        font-size: 12px;
        font-weight: 600;
        color: var(--v-ink-2);
        letter-spacing: -0.003em;
        text-align: center;
        line-height: 1.45;
        max-width: 26ch;
    }
    @media (max-width: 1024px) {
        .v-sovereignty-inner { padding: 80px 32px 88px; }
        .v-sov-head { margin-bottom: 48px; }
        .v-sov-mark { padding: 28px 24px; min-height: 220px; }
        .v-sov-mark-title { font-size: 20px; }
    }
    @media (max-width: 820px) {
        .v-sovereignty-inner { padding: 64px 24px 72px; }
        .v-sov-head { margin-bottom: 40px; }
        .v-sov-marks { grid-template-columns: 1fr; gap: 16px; }
        .v-sov-mark { min-height: 180px; }
    }

    /* Trust strip (logo marquee) */
    .v-trust {
        background: var(--v-bg-band);
        border-top: 1px solid var(--v-line);
        border-bottom: 1px solid var(--v-line);
        font-family: var(--v-sans);
        padding: 64px 0 72px;
        overflow: hidden;
        position: relative;
        z-index: 1;
    }
    .v-trust-label {
        text-align: center;
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--v-ink-3);
        margin: 0 0 36px;
    }
    .v-trust-marquee {
        position: relative;
        overflow: hidden;
        -webkit-mask-image: linear-gradient(to right, transparent 0, black 96px, black calc(100% - 96px), transparent 100%);
        mask-image: linear-gradient(to right, transparent 0, black 96px, black calc(100% - 96px), transparent 100%);
    }
    .v-trust-track {
        display: flex;
        align-items: center;
        gap: 96px;
        width: max-content;
        animation: v-marquee 60s linear infinite;
    }
    @keyframes v-marquee {
        0%   { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }
    .v-trust:hover .v-trust-track { animation-play-state: paused; }
    .v-trust-track img {
        height: 56px;
        width: auto;
        object-fit: contain;
        filter: grayscale(100%);
        opacity: 0.6;
        transition: opacity 0.2s ease, filter 0.2s ease;
        flex-shrink: 0;
    }
    .v-trust-track img:hover { opacity: 1; filter: grayscale(0%); }
    @media (max-width: 768px) {
        .v-trust { padding: 48px 0 56px; }
        .v-trust-label { font-size: 10.5px; margin-bottom: 24px; }
        .v-trust-track { gap: 64px; }
        .v-trust-track img { height: 40px; }
    }
    @media (prefers-reduced-motion: reduce) {
        .v-trust-track { animation: none; transform: none; }
    }

    /* Comparison table */
    .v-comp {
        background: var(--v-bg-dark);
        border-top: 1px solid var(--v-line-dark);
        font-family: var(--v-sans);
        position: relative;
        z-index: 1;
        overflow: hidden;
    }
    .v-comp::before {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        width: min(55vw, 520px);
        height: 100%;
        background: radial-gradient(ellipse at 100% 20%, rgba(232, 150, 21, 0.14) 0%, transparent 65%);
        pointer-events: none;
    }
    .v-comp-inner {
        max-width: 1240px;
        margin: 0 auto;
        padding: 88px 40px 96px;
        position: relative;
    }
    .v-comp-header { max-width: 820px; margin-bottom: 48px; }
    .v-comp-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--v-amber);
        margin: 0 0 20px;
    }
    .v-comp-eyebrow::before { content: ''; width: 32px; height: 2px; background: var(--v-amber); }
    .v-comp-headline {
        font-size: clamp(32px, 4vw, 52px);
        line-height: 1.05;
        letter-spacing: -0.035em;
        font-weight: 800;
        color: #fff;
        margin: 0 0 20px;
    }
    .v-comp-headline em { font-style: normal; color: var(--v-amber); }
    .v-comp-sub {
        font-size: 18px;
        line-height: 1.5;
        color: rgba(255, 255, 255, 0.62);
        margin: 0;
        font-weight: 500;
    }
    .v-comp-table-wrap {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        border-radius: 10px;
        background: #fff;
        box-shadow:
            0 0 0 1px rgba(255, 255, 255, 0.06),
