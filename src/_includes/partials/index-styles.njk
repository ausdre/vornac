    /* Motion layer — anime.js-driven (see partials/home-motion.njk).
       Elements start hidden ONLY while the page is "armed": html.v-armed is
       set synchronously in <head> and only when prefers-reduced-motion is
       no-preference. Reduced-motion, no-JS, or a failed anime.js load never
       arm (or un-arm), so the full page stays visible — no FOUC, no trap.
       anime.js owns the easing/stagger, so no CSS transitions live here. */
    html.v-armed .v-reveal {
        opacity: 0;
        transform: translateY(16px);
