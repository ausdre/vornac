        transition: transform 0.18s ease;
        color: var(--v-ink);
        position: relative;
    }
    .v-sov-mark-num { display: none; }
    a.v-sov-mark:hover { transform: translateY(-2px); }
    .v-sov-mark--flag { justify-content: space-between; }
    .v-sov-mark-flag {
        display: flex;
        height: 6px;
        width: 60px;
        overflow: hidden;
        margin-bottom: 24px;
    }
    .v-sov-mark-flag span { display: block; height: 100%; width: 33.333%; }
    .v-sov-mark-flag span:nth-child(1) { background: #000000; }
    .v-sov-mark-flag span:nth-child(2) { background: #DD0000; }
    .v-sov-mark-flag span:nth-child(3) { background: #FFCC00; }
    .v-sov-mark-title {
        font-family: var(--v-sans);
        font-size: 22px;
        font-weight: 700;
        line-height: 1.22;
        letter-spacing: -0.018em;
