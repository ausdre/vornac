    @media (max-width: 768px) {
        .v-comp-inner { padding: 80px 28px 80px; }
        .v-comp-header { margin-bottom: 32px; }
        .v-comp-sub { font-size: 16px; }

        /* Card stack on mobile — table HTML stays semantic, layout becomes blocks */
        .v-comp-table-wrap {
            overflow-x: visible;
            background: transparent;
            border-top: none;
        }
        .v-comp-table {
            min-width: 0;
            display: block;
        }
        .v-comp-table thead { display: none; }
        .v-comp-table tbody { display: block; }
        .v-comp-table tbody tr {
            display: block;
            background: rgba(255, 255, 255, 0.025);
            border: 1px solid var(--v-line-dark);
            border-radius: 12px;
            margin-bottom: 16px;
            padding: 4px 0 0;
        }
        .v-comp-table tbody tr:last-child { margin-bottom: 0; }
        .v-comp-table tbody tr:hover th,
        .v-comp-table tbody tr:hover td:not(.v-comp-col-vornac) { background: transparent; }

        .v-comp-table tbody th[scope="row"] {
            display: block;
            background: transparent;
            color: #fff;
            padding: 20px 22px 16px;
            border-bottom: 1px solid var(--v-line-dark);
            font-size: 16px;
            line-height: 1.3;
            font-weight: 700;
        }
        .v-comp-table tbody td {
            display: block;
            padding: 16px 22px 18px;
            border-bottom: 1px solid var(--v-line-dark);
            background: transparent;
            position: relative;
        }
        .v-comp-table tbody tr td:last-child { border-bottom: 0; }
        .v-comp-table tbody td::before {
            display: block;
            font-family: var(--v-mono);
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: rgba(255, 255, 255, 0.35);
            margin-bottom: 10px;
        }
        .v-comp-table tbody td:nth-of-type(1)::before { content: "Classical tools (VM · BAS · EASM)"; }
        .v-comp-table tbody td:nth-of-type(2)::before { content: "Pentera"; }
        .v-comp-table tbody td:nth-of-type(3)::before { content: "VORNAC"; color: var(--v-amber); }

        .v-comp-table tbody td.v-comp-col-vornac {
            box-shadow: none;
            background: rgba(255, 163, 23, 0.06);
            border-top: 1px solid rgba(255, 163, 23, 0.4);
        }
        .v-comp-table tbody td.v-comp-col-vornac:not(:last-child) { border-bottom: 1px solid var(--v-line-dark); }
    }

