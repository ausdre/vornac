{#
  Shared CSS for the homepage (index EN + index DE).

  This is the v-* design system that appears only on the homepage:
    - Hero (.v-hero, .v-hero-headline, .v-amber-mark, …)
    - Light + dark stats bands (.v-stats, .v-stat-number, .v-stat-rule, …)
    - German data sovereignty (.v-sovereignty, .v-sov-mark, …)
    - Trust strip / logo marquee (.v-trust, .v-trust-track, …)
    - Comparison table (.v-comp, .v-comp-table, .v-comp-status--*, …)
    - Polish-pass additions (motion, focus rings, sticky mobile column)

  Includes a "color tokens" :root block and small utilities (.bg-warm*) so
  the homepage works even if shared input.css updates lag behind.

  Each language version of the homepage overlays its own `.v-amber-mark`
  rule on top of this partial — see notes in /index.njk and /de/index.njk.
  The amber-mark behaves differently in EN vs DE because:
    - EN headline phrase is short and single-line, so EN uses a ::after band.
    - DE headline phrase is long and wraps, so DE uses background-image
      gradient with box-decoration-break: clone for per-line bands.
#}
<style>
    :root {
        --color-bg: #ffffff;
        --color-bg-soft: #f5f5f4;
        --color-bg-muted: #e7e5e4;
        --color-accent: #ffa317;
        --color-accent-dark: #cc8200;
        --color-text: #1c1917;
        --color-text-muted: #57534e;

        /* Enterprise tokens (vornac clean white + confident amber) */
        --v-bg:        #ffffff;
        --v-bg-band:   #f5f5f4;
        --v-bg-card:   #ffffff;
        --v-bg-dark:   #0E1116;
        --v-bg-dark-2: #181C24;
        --v-ink:       #0E1116;
        --v-ink-2:     #4B5260;
        --v-ink-3:     #7A8190;
        --v-line:      #e7e5e4;
        --v-line-soft: #f1f0ee;
        --v-line-dark: #2A2F39;
        --v-amber:     #ffa317;
        --v-amber-deep:#cc8200;
        --v-amber-soft:#fff3d8;
        --v-display: 'Saira Condensed', 'Archivo', system-ui, -apple-system, sans-serif;
        --v-sans:    'Archivo', system-ui, -apple-system, sans-serif;
        --v-mono:    'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace;
    }

    /* Homepage body — white. Other pages share this default via input.css. */
    .bg-warm { background-color: #ffffff; }
    .bg-warm-soft { background-color: #ffffff; }
    .bg-warm-muted { background-color: #ffffff; }

    /* Announcement bar */
    .v-announcement {
        background: #ffffff;
        color: var(--v-ink);
        font-family: var(--v-sans);
        font-size: 13.5px;
        font-weight: 500;
        padding: 11px 0;
        text-align: center;
        position: relative;
        z-index: 60;
        letter-spacing: -0.005em;
        border-bottom: 1px solid var(--v-line);
    }
    .v-announcement-inner {
        max-width: 1320px;
        margin: 0 auto;
        padding: 0 32px;
    }
    .v-announcement-tag {
        display: inline-block;
        background: var(--v-amber);
        color: var(--v-bg-dark);
        font-size: 10.5px;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 3px 8px;
        margin-right: 14px;
        vertical-align: 2px;
    }
    .v-announcement a {
        color: var(--v-ink);
        text-decoration: none;
        border-bottom: 1px solid rgba(14,17,22,0.28);
        padding-bottom: 1px;
        margin-left: 8px;
        transition: border-color 0.15s, color 0.15s;
        font-weight: 600;
    }
    .v-announcement a:hover {
        border-bottom-color: var(--v-amber-deep);
        color: var(--v-amber-deep);
    }
    @media (max-width: 640px) {
        .v-announcement { font-size: 12.5px; padding: 10px 0; }
        .v-announcement-inner { padding: 0 20px; }
        .v-announcement a { display: inline-block; margin-left: 4px; }
    }

    /* Hero — clean white field. Amber appears only as a sparing accent on
       the emphasized headline phrase. */
    .v-hero {
        background: var(--v-bg);
        font-family: var(--v-sans);
        position: relative;
        z-index: 1;
        overflow: hidden;
    }
    .v-hero-inner {
        position: relative;
        z-index: 1;
        max-width: 1240px;
        margin: 0 auto;
        padding: 152px 48px 132px;
        text-align: center;
    }
    .v-hero-kicker {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-size: 12.5px;
        font-weight: 700;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--v-amber);
        margin-bottom: 40px;
        font-family: var(--v-mono);
        font-weight: 500;
        font-size: 12px;
    }
    .v-hero-kicker::before {
        content: '';
        width: 28px;
        height: 1px;
        background: var(--v-amber);
    }
    .v-hero-headline {
        font-family: var(--v-display);
        font-size: clamp(48px, 6.8vw, 112px);
        line-height: 0.95;
        letter-spacing: -0.02em;
        font-weight: 900;
        color: var(--v-ink);
        margin: 0 auto 48px;
        max-width: 20ch;
        overflow-wrap: break-word;
    }
    /* On the white hero the emphasized phrase carries the single amber accent. */
    .v-hero-headline .v-amber-mark { color: var(--v-amber-deep); }
    .v-hero-headline .v-hero-lead {
        font-size: larger;
    }
    .v-hero-subline {
        font-family: var(--v-sans);
        font-size: 20px;
        line-height: 1.6;
        color: var(--v-ink-2);
        max-width: 680px;
        margin: 0 auto 56px;
        font-weight: 400;
    }
    .v-hero-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 28px;
        flex-wrap: wrap;
        margin-bottom: 56px;
    }
    .v-hero-trust {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: center;
        gap: 16px 20px;
        margin: 88px auto 0;
        max-width: 740px;
        font-family: var(--v-sans);
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        line-height: 1.5;
    }
    .v-hero-trust-label {
        color: var(--v-ink-2);
    }
    .v-hero-trust-list {
        font-family: var(--v-mono);
        color: var(--v-ink-3);
        font-weight: 500;
        letter-spacing: 0.06em;
        font-size: 11px;
    }
    /* Thin outline primary (Palantir-restrained). Homepage-scoped: .v-btn-primary
       is used only on the EN/DE homepage. Hero overrides this to an amber outline. */
    .v-btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 15px 27px;
        background: transparent;
        color: var(--v-ink);
        text-decoration: none;
        font-family: var(--v-sans);
        font-size: 15px;
        font-weight: 600;
        border: 1px solid var(--v-ink);
        transition: background 0.15s, color 0.15s, border-color 0.15s;
        letter-spacing: -0.005em;
    }
    .v-btn-primary:hover { background: var(--v-ink); color: #fff; }
    .v-btn-primary svg { transition: transform 0.2s ease; }
    .v-btn-primary:hover svg { transform: translateX(3px); }
    .v-btn-ghost {
        color: var(--v-ink);
        text-decoration: none;
        font-family: var(--v-sans);
        font-size: 15px;
        font-weight: 600;
        padding: 6px 0;
        border-bottom: 2px solid var(--v-ink);
        transition: color 0.15s, border-color 0.15s;
        letter-spacing: -0.005em;
    }
    .v-btn-ghost:hover {
        color: var(--v-amber-deep);
        border-bottom-color: var(--v-amber-deep);
    }
    .v-hero-category {
        font-family: var(--v-sans);
        font-size: 15px;
        font-weight: 500;
        color: var(--v-ink-2);
        border-left: 3px solid var(--v-amber);
        padding-left: 18px;
        max-width: 520px;
        line-height: 1.5;
        letter-spacing: -0.003em;
    }
    /* Buttons over the white hero: amber outline primary + ink ghost.
       Amber stays the single sparing accent. */
    .v-hero .v-btn-primary {
        background: transparent;
        color: var(--v-amber-deep);
        border: 1px solid var(--v-amber);
        padding: 15px 27px;
    }
    .v-hero .v-btn-primary:hover {
        background: var(--v-amber);
        color: var(--v-bg-dark);
        border-color: var(--v-amber);
    }
    /* .v-hero .v-btn-ghost inherits the default ink ghost; no override needed. */

    /* Hero "Book a demo" — a wider amber-outline pill that morphs into an
       inline email capture on hover (desktop) or tap (mobile, .is-open via JS).
       Collapsed: centered "Book a demo" label. Expanded: email input + submit. */
    .v-hero-demo {
        position: relative;
        display: inline-flex;
        align-items: center;
        width: 248px;
        height: 54px;
        border: 1px solid var(--v-amber);
        background: transparent;
        overflow: hidden;
        transition: width 0.42s cubic-bezier(0.22, 1, 0.36, 1), background 0.2s ease, box-shadow 0.2s ease;
    }
    .v-hero-demo-trigger {
        position: absolute;
        inset: 0;
        z-index: 2;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        background: transparent;
        border: none;
        color: var(--v-amber-deep);
        font-family: var(--v-sans);
        font-size: 15px;
        font-weight: 600;
        letter-spacing: -0.005em;
        cursor: pointer;
        transition: opacity 0.2s ease;
    }
    .v-hero-demo-reveal {
        display: flex;
        align-items: center;
        width: 100%;
        height: 100%;
        opacity: 0;
        transition: opacity 0.25s ease 0.06s;
    }
    .v-hero-demo-input {
        flex: 1;
        min-width: 0;
        height: 100%;
        background: transparent;
        border: none;
        outline: none;
        color: var(--v-ink);
        font-family: var(--v-sans);
        font-size: 15px;
        letter-spacing: -0.005em;
        padding: 0 18px;
    }
    .v-hero-demo-input::placeholder { color: var(--v-ink-3); }
    .v-hero-demo-submit {
        flex-shrink: 0;
        height: 100%;
        width: 54px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--v-amber);
        color: var(--v-bg-dark);
        border: none;
        cursor: pointer;
        transition: background 0.18s ease;
    }
    .v-hero-demo-submit:hover { background: #ffb53d; }
    .v-hero-demo:focus-within {
        box-shadow: 0 0 0 3px rgba(255, 163, 23, 0.18);
    }
    .v-hero-demo:hover,
    .v-hero-demo.is-open {
        width: 392px;
        background: rgba(255, 163, 23, 0.06);
    }
    .v-hero-demo:hover .v-hero-demo-trigger,
    .v-hero-demo.is-open .v-hero-demo-trigger {
        opacity: 0;
        pointer-events: none;
    }
    .v-hero-demo:hover .v-hero-demo-reveal,
    .v-hero-demo.is-open .v-hero-demo-reveal {
        opacity: 1;
    }
    @media (prefers-reduced-motion: reduce) {
        .v-hero-demo { transition: none; }
        .v-hero-demo-reveal { transition: none; }
    }

    @media (max-width: 768px) {
        .v-hero-inner { padding: 80px 28px 96px; }
        .v-hero-headline { font-size: clamp(34px, 9vw, 56px); letter-spacing: -0.02em; margin-bottom: 28px; }
        .v-hero-actions { gap: 20px; margin-bottom: 40px; }
        .v-hero-demo { width: 232px; height: 52px; }
        .v-hero-demo.is-open { width: min(100%, 340px); }
        .v-hero-subline { font-size: 17px; margin-bottom: 44px; }
        .v-hero-kicker { margin-bottom: 28px; font-size: 11px; }
        .v-hero-trust { margin-top: 56px; }
        .v-hero-trust { padding-top: 20px; gap: 10px 14px; margin-bottom: 0; font-size: 10.5px; }
    }

    /* Stats band */
    .v-stats {
        background: var(--v-bg);
        font-family: var(--v-sans);
        position: relative;
        z-index: 1;
    }
    .v-stats.is-dark {
        background: var(--v-bg-dark);
    }
    .v-stats-inner {
        max-width: 1240px;
        margin: 0 auto;
        padding: 140px 48px 140px;
    }
    .v-stats-kicker {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-family: var(--v-mono);
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--v-amber-deep);
        margin: 0 0 72px;
    }
    .v-stats-kicker::before {
        content: '';
        width: 28px;
        height: 1px;
        background: var(--v-amber);
    }
    .v-stats.is-dark .v-stats-kicker { color: var(--v-amber); }
    .v-stats-headline {
        font-family: var(--v-display);
        font-size: clamp(40px, 5.4vw, 78px);
        line-height: 1.04;
        letter-spacing: -0.018em;
        font-weight: 500;
        color: var(--v-ink);
        margin: 0 auto 88px;
        max-width: 22ch;
        text-align: center;
    }
    .v-stats.is-dark .v-stats-headline { color: #fff; }
    /* Subline-style intro sentence over a stats section. Use instead of
       (or alongside) .v-stats-headline when the lead is explanatory prose. */
    .v-stats-intro {
        font-family: var(--v-sans);
        font-size: 19px;
        line-height: 1.6;
        color: var(--v-ink-2);
        font-weight: 500;
        margin: 0 auto 72px;
        max-width: 760px;
        text-align: center;
    }
    .v-stats.is-dark .v-stats-intro { color: rgba(255, 255, 255, 0.7); }
    @media (max-width: 768px) {
        .v-stats-intro { font-size: 16px; margin-bottom: 48px; max-width: none; }
    }
    .v-stats-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 0;
    }
    .v-stats-grid.is-four { grid-template-columns: 1fr 1fr 1fr 1fr; }
    .v-stat { position: relative; padding: 0 72px; text-align: center; }
    .v-stats-grid.is-four .v-stat { padding: 0 32px; }
    .v-stats-grid.is-four .v-stat:first-child { padding-left: 0; }
    .v-stats-grid.is-four .v-stat:last-child  { padding-right: 0; }
    .v-stats-grid.is-four .v-stat-number {
        font-size: clamp(64px, 6.8vw, 108px);
        margin-bottom: 26px;
    }
    .v-stats-grid.is-four .v-stat-label { font-size: 16px; max-width: 20ch; }
    .v-stats-grid.is-four .v-stat-prefix { font-size: clamp(16px, 1.5vw, 24px); }
    .v-stats-grid.is-four .v-stat-prefix + .v-stat-num { margin-left: 10px; }
    .v-stat-number {
        font-family: var(--v-display);
        font-weight: 600;
        font-size: clamp(82px, 9.4vw, 148px);
        line-height: 0.88;
        letter-spacing: -0.04em;
        color: var(--v-ink);
        display: flex;
        align-items: baseline;
        justify-content: center;
        gap: 0;
        margin-bottom: 30px;
        white-space: nowrap;
    }
    .v-stats.is-dark .v-stat-number { color: #fff; }
    .v-stat-num { display: inline-block; }
    .v-stat-prefix + .v-stat-num { margin-left: 14px; }
    .v-stat-prefix {
        font-family: var(--v-sans);
        font-weight: 700;
        font-size: clamp(20px, 1.9vw, 30px);
        letter-spacing: -0.01em;
        color: var(--v-ink-3);
        line-height: 1;
        text-transform: lowercase;
    }
    .v-stat-range {
        font-weight: 700;
        font-size: 0.46em;
        letter-spacing: -0.02em;
        color: rgba(0, 0, 0, 0.32);
        margin-left: 0.02em;
    }
    .v-stats.is-dark .v-stat-range { color: rgba(255, 255, 255, 0.40); }
    .v-stat-unit {
        font-weight: 800;
        font-size: 0.62em;
        margin-left: 0.04em;
        color: var(--v-amber);
    }
    .v-stats.is-dark .v-stat-unit { font-size: 0.5em; margin-left: 0.06em; }
    .v-stat-rule {
        display: none;
    }
    .v-stat-label {
        font-family: var(--v-display);
        font-size: clamp(20px, 1.7vw, 26px);
        font-weight: 600;
        line-height: 1.15;
        color: var(--v-ink);
        letter-spacing: -0.02em;
        max-width: 18ch;
        margin-left: auto;
        margin-right: auto;
    }
    .v-stats.is-dark .v-stat-label { color: #fff; }
    .v-stat-label .v-stat-label-sub {
        display: block;
        font-family: var(--v-sans);
        font-weight: 500;
        color: var(--v-ink-2);
        font-size: 15px;
        margin-top: 14px;
        letter-spacing: -0.003em;
        line-height: 1.5;
        max-width: 34ch;
        margin-left: auto;
        margin-right: auto;
    }
    .v-stats.is-dark .v-stat-label .v-stat-label-sub { color: rgba(255, 255, 255, 0.62); }
    .v-stats.is-dark .v-stat-label .v-stat-label-sub { color: rgba(255, 255, 255, 0.7); }

    @media (max-width: 1024px) {
        .v-stats-inner { padding: 96px 36px 96px; }
        .v-stat { padding: 0 36px; }
        .v-stats-headline { margin-bottom: 48px; }
        .v-stats-grid.is-four { grid-template-columns: 1fr 1fr; row-gap: 56px; }
        .v-stats-grid.is-four .v-stat { padding: 0 32px; }
        .v-stats-grid.is-four .v-stat:nth-child(2n+1) { padding-left: 0; }
        .v-stats-grid.is-four .v-stat:nth-child(2n)   { padding-right: 0; }
        .v-stats-grid.is-four .v-stat-number { font-size: clamp(72px, 10vw, 120px); }
    }

    /* How VORNAC works — high-level mechanism, sits between stats + sovereignty */
    .v-howwe {
        background: var(--v-bg);
        font-family: var(--v-sans);
        position: relative;
        z-index: 1;
    }
    .v-howwe-inner {
        max-width: 1240px;
        margin: 0 auto;
        padding: 140px 48px 140px;
    }
    .v-howwe-head {
        max-width: 920px;
        margin: 0 auto 80px;
        text-align: center;
    }
    .v-howwe-headline {
        font-family: var(--v-display);
        font-size: clamp(40px, 5.2vw, 76px);
        line-height: 1.0;
        letter-spacing: -0.035em;
        font-weight: 900;
        color: var(--v-ink);
        margin: 0 0 28px;
    }
    .v-howwe-headline .v-howwe-emph { color: var(--v-amber-deep); }
    .v-howwe-sub {
        font-size: 19px;
        line-height: 1.6;
        color: var(--v-ink-2);
        margin: 0;
        font-weight: 500;
        max-width: 720px;
        margin-left: auto;
        margin-right: auto;
    }
    .v-howwe-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0;
        border-top: 1px solid var(--v-line);
    }
    .v-howwe-item {
        padding: 48px 36px 12px;
        border-right: 1px solid var(--v-line);
        position: relative;
    }
    .v-howwe-item:last-child { border-right: none; }
    .v-howwe-num {
        font-family: var(--v-mono);
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.18em;
        color: var(--v-amber-deep);
        margin-bottom: 28px;
        display: block;
    }
    .v-howwe-title {
        font-family: var(--v-display);
        font-size: clamp(22px, 1.9vw, 30px);
        line-height: 1.1;
        letter-spacing: -0.02em;
        font-weight: 900;
        color: var(--v-ink);
        margin: 0 0 20px;
    }
    .v-howwe-desc {
        font-size: 16px;
        line-height: 1.6;
        color: var(--v-ink-2);
        font-weight: 500;
        margin: 0;
    }
    .v-howwe-desc strong {
        color: var(--v-ink);
        font-weight: 700;
    }
    @media (max-width: 920px) {
        .v-howwe-inner { padding: 80px 24px 80px; }
        .v-howwe-head { margin-bottom: 56px; }
        .v-howwe-grid {
            grid-template-columns: 1fr;
            border-top: 1px solid var(--v-line);
        }
        .v-howwe-item {
            padding: 36px 0 36px;
            border-right: none;
            border-bottom: 1px solid var(--v-line);
        }
        .v-howwe-item:last-child { border-bottom: none; }
        .v-howwe-num { margin-bottom: 20px; }
    }

    /* German data sovereignty */
    .v-sovereignty {
        background: var(--v-bg);
        font-family: var(--v-sans);
        position: relative;
        z-index: 1;
    }
    .v-sovereignty-inner {
        max-width: 1240px;
        margin: 0 auto;
        padding: 140px 48px 140px;
    }
    .v-sov-head { max-width: 880px; margin: 0 auto 88px; text-align: center; }
    .v-sov-kicker {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-family: var(--v-mono);
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--v-amber-deep);
        margin-bottom: 36px;
    }
    .v-sov-kicker::before { content: ''; width: 28px; height: 1px; background: var(--v-amber); }
    .v-sov-headline {
        font-family: var(--v-display);
        font-size: clamp(40px, 5.4vw, 78px);
        line-height: 1.04;
        letter-spacing: -0.018em;
        font-weight: 500;
        color: var(--v-ink);
        margin: 0 0 36px;
    }
    .v-sov-headline .v-sov-emph { color: var(--v-amber-deep); font-weight: 500; }
    .v-sov-subline {
        font-family: var(--v-sans);
        font-size: 17px;
        line-height: 1.6;
        color: var(--v-ink-2);
        margin: 0 auto;
        font-weight: 400;
        max-width: 680px;
    }
    .v-sov-marks {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 28px;
    }
    .v-sov-mark {
        background: var(--v-bg-card);
        border: none;
        padding: 40px 34px;
        display: flex;
        flex-direction: column;
        min-height: 268px;
