    /* Trust strip (logo marquee) */
    .v-trust {
        background: var(--v-bg);
        font-family: var(--v-sans);
        padding: 100px 0 100px;
        overflow: hidden;
        position: relative;
        z-index: 1;
    }
    .v-trust-label {
        text-align: center;
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--v-ink-3);
        margin: 0 0 36px;
    }
    .v-trust-lanes {
        display: flex;
        flex-direction: column;
        gap: 56px;
    }
    .v-trust-marquee {
        position: relative;
        overflow: hidden;
        -webkit-mask-image: linear-gradient(to right, transparent 0, black 96px, black calc(100% - 96px), transparent 100%);
        mask-image: linear-gradient(to right, transparent 0, black 96px, black calc(100% - 96px), transparent 100%);
    }
    .v-trust-track {
        display: flex;
        align-items: center;
        gap: 96px;
        width: max-content;
        animation: v-marquee 60s linear infinite;
    }
    /* Second lane runs the opposite direction (and at a slightly different
       pace so the two rows never look mirror-locked). */
    .v-trust-track--reverse {
        animation-direction: reverse;
        animation-duration: 72s;
    }
    @keyframes v-marquee {
        0%   { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }
    /* Only pause a lane while a logo itself is hovered — not on entering the
       section or hovering the gaps between logos. */
    .v-trust-track:has(img:hover) { animation-play-state: paused; }
    /* Each logo is normalised into the same bounding box (height + width
       capped) so wide wordmarks and square marks read as one visual size. */
    .v-trust-track img {
        height: auto;
        width: auto;
        max-height: 72px;
        max-width: 168px;
        object-fit: contain;
        filter: grayscale(100%);
        opacity: 0.6;
        transition: opacity 0.2s ease, filter 0.2s ease;
        flex-shrink: 0;
    }
    /* Square brand marks (GitHub, OWASP) get a slightly smaller box so they
       don't optically dominate the wordmarks. */
    .v-trust-track img.v-trust-ico { max-height: 54px; max-width: 54px; }
    .v-trust-track img:hover { opacity: 1; filter: grayscale(0%); }
    @media (max-width: 768px) {
        .v-trust { padding: 88px 0 88px; }
        .v-trust-label { font-size: 10.5px; margin-bottom: 24px; }
        .v-trust-lanes { gap: 36px; }
        .v-trust-track { gap: 64px; }
        .v-trust-track img { max-height: 48px; max-width: 120px; }
        .v-trust-track img.v-trust-ico { max-height: 38px; max-width: 38px; }
    }
    @media (prefers-reduced-motion: reduce) {
        .v-trust-track { animation: none; transform: none; }
    }

    /* Comparison table */
    .v-comp {
        background: var(--v-bg-dark);
        font-family: var(--v-sans);
        position: relative;
        z-index: 1;
        overflow: hidden;
    }
    .v-comp-inner {
        max-width: 1240px;
        margin: 0 auto;
        padding: 140px 48px 140px;
        position: relative;
    }
    .v-comp-header { max-width: 880px; margin: 0 auto 80px; text-align: center; }
    .v-comp-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-family: var(--v-mono);
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--v-amber);
        margin: 0 0 32px;
    }
    .v-comp-eyebrow::before { content: ''; width: 28px; height: 1px; background: var(--v-amber); }
    .v-comp-headline {
        font-family: var(--v-display);
        font-size: clamp(40px, 5.4vw, 78px);
        line-height: 1.04;
        letter-spacing: -0.018em;
        font-weight: 500;
        color: #fff;
        margin: 0 0 28px;
    }
    .v-comp-headline em { font-style: normal; color: var(--v-amber); font-weight: 500; }
    .v-comp-sub {
        font-size: 19px;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.62);
        margin: 0 auto;
        max-width: 60ch;
        font-weight: 500;
    }
    .v-comp-table-wrap {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        background: transparent;
        border-top: 1px solid var(--v-line-dark);
    }
    .v-comp-table {
        width: 100%;
        min-width: 920px;
        border-collapse: collapse;
        font-size: 14.5px;
        line-height: 1.45;
    }
    .v-comp-table caption {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }
    .v-comp-table thead th {
        text-align: left;
        padding: 22px 26px;
        font-family: var(--v-mono);
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.82);
        background: transparent;
        border-bottom: 1px solid var(--v-line-dark);
        vertical-align: bottom;
    }
    .v-comp-table thead th:first-child {
        min-width: 240px;
        font-size: 11px;
        letter-spacing: 0.08em;
        color: rgba(255, 255, 255, 0.55);
    }
    .v-comp-col-sub {
        display: block;
        font-weight: 500;
        text-transform: none;
        letter-spacing: 0;
        font-size: 11px;
        opacity: 0.6;
        margin-top: 6px;
    }
    .v-comp-table thead th.v-comp-col-vornac {
        color: #fff;
        background: transparent;
        border-bottom: 2px solid var(--v-amber);
    }
    .v-comp-logo {
        display: block;
        height: 20px;
        width: auto;
        max-width: none;
        margin: 0;
        /* white logo on dark; the source SVG is black, so invert it */
        filter: brightness(0) invert(1);
    }
    .v-comp-brand-sub {
        display: block;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.14em;
        color: var(--v-amber);
        opacity: 0.9;
        margin-top: 0;
    }
    .v-comp-table tbody th {
        text-align: left;
        padding: 30px 26px;
        font-weight: 700;
        color: #fff;
        background: transparent;
        border-bottom: 1px solid var(--v-line-dark);
        vertical-align: top;
        font-size: 15px;
        line-height: 1.35;
        letter-spacing: -0.01em;
    }
    .v-comp-table tbody td {
        padding: 30px 26px;
        color: rgba(255, 255, 255, 0.75);
        border-bottom: 1px solid var(--v-line-dark);
        vertical-align: top;
        background: transparent;
    }
    .v-comp-table tbody tr:hover td:not(.v-comp-col-vornac),
    .v-comp-table tbody tr:hover th { background: rgba(255, 255, 255, 0.02); }
    .v-comp-table tbody tr:last-child th,
    .v-comp-table tbody tr:last-child td { border-bottom: none; }
    .v-comp-table tbody td.v-comp-col-vornac {
        background: rgba(255, 163, 23, 0.05);
        color: rgba(255, 255, 255, 0.72);
        box-shadow: inset 1px 0 0 rgba(255, 163, 23, 0.4), inset -1px 0 0 rgba(255, 163, 23, 0.4);
    }
    .v-comp-table tbody tr:hover td.v-comp-col-vornac {
        background: rgba(255, 163, 23, 0.09);
    }
    .v-comp-table thead th.v-comp-col-vornac {
        box-shadow: inset 1px 0 0 rgba(255, 163, 23, 0.4), inset -1px 0 0 rgba(255, 163, 23, 0.4);
    }
    .v-comp-cell-top {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
        margin-bottom: 10px;
    }
    /* Monochrome status markers — symbol + word, no fill */
    .v-comp-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-weight: 700;
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: 0;
        line-height: 1;
        margin-bottom: 12px;
        background: transparent;
    }
    .v-comp-cell-top .v-comp-status { margin-bottom: 0; }
    .v-comp-status::before {
        font-size: 13px;
        font-weight: 900;
        line-height: 1;
        width: 18px;
        height: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }
    .v-comp-status--yes { color: rgba(255, 255, 255, 0.85); }
    .v-comp-status--yes::before {
        content: '✓';
        color: #6ee7a8;
        border: 1px solid rgba(110, 231, 168, 0.35);
    }
    .v-comp-status--no { color: rgba(255, 255, 255, 0.72); }
    .v-comp-status--no::before {
        content: '✕';
        color: #ff4d4d;
        border: 1px solid rgba(255, 77, 77, 0.45);
    }
    .v-comp-status--partial { color: rgba(255, 255, 255, 0.72); }
    .v-comp-status--partial::before {
        content: '~';
        color: rgba(255, 255, 255, 0.5);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }
    /* VORNAC column: the only place the amber check appears */
    .v-comp-col-vornac .v-comp-status--yes { color: #fff; }
    .v-comp-col-vornac .v-comp-status--yes::before {
        content: '✓';
        color: var(--v-bg-dark);
        background: var(--v-amber);
        border: 1px solid var(--v-amber);
    }
    .v-comp-detail {
        display: block;
        font-weight: 400;
        font-size: 13px;
        color: rgba(255, 255, 255, 0.7);
        text-transform: none;
        letter-spacing: 0;
        line-height: 1.55;
    }
    .v-comp-col-vornac .v-comp-detail {
        color: rgba(255, 255, 255, 0.85);
        font-size: 13.5px;
    }
    .v-comp-usp {
        display: inline-flex;
        align-items: center;
        font-size: 9.5px;
        font-weight: 800;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--v-amber);
        background: transparent;
        border: 1px solid rgba(255, 163, 23, 0.45);
        padding: 4px 9px;
        flex-shrink: 0;
