{# JSON-LD for a single Research note: TechArticle plus the BreadcrumbList
   that mirrors the visible trail in research-note-render.njk (Research Index
   / domain / note). Included from the extraHead block of both note templates.

   Inputs in scope: note, locale, pageUrls, site, canonicalPath, published,
   updated. Dates come from research.js, never the build.
#}
{% set noteUrl = canonicalPath | absoluteUrl(site.domain) %}
{% set researchUrl = pageUrls.research | absoluteUrl(site.domain) %}
{% set domainUrl = pageUrls["research-" + note.domain] | absoluteUrl(site.domain) %}
{% set breadcrumbHome = "Research Index" if locale == "en" else "Research-Index" %}
{% set domainCrumb = note.domainNumber + " · " + note.domainTitle[locale] %}
{% set ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      "@id": noteUrl + "#article",
      "mainEntityOfPage": { "@type": "WebPage", "@id": noteUrl },
      "url": noteUrl,
      "headline": note.title[locale],
      "description": note.blurb[locale],
      "inLanguage": locale,
      "datePublished": published,
      "dateModified": updated,
      "author": { "@id": site.organizationId },
      "publisher": { "@id": site.organizationId },
      "isPartOf": { "@type": "CollectionPage", "@id": domainUrl, "name": note.domainTitle[locale], "url": domainUrl },
      "articleSection": note.domainTitle[locale],
      "keywords": note.phaseLabels[locale],
      "isAccessibleForFree": true
    },
    {
      "@type": "BreadcrumbList",
      "@id": noteUrl + "#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": breadcrumbHome, "item": researchUrl },
        { "@type": "ListItem", "position": 2, "name": domainCrumb, "item": domainUrl },
        { "@type": "ListItem", "position": 3, "name": note.title[locale], "item": noteUrl }
      ]
    },
    site.organizationLd
  ]
} %}
<script type="application/ld+json">{{ ld | jsonLd | safe }}</script>
