<script>
    /* Sticky logo positioning + adaptive colour + sticky-burger reveal.
       - The fixed logo mirrors the in-flow spacer's position, then clamps near
         the top so it stays pinned as the bar scrolls away.
       - Logo + sticky burger recolour (white/ink) based on the luminance of the
         section behind them, so they stay legible over dark and light areas.
       - The sticky burger slides in once scrolled past ~1.5 viewport heights. */
    /* First-visit intro: when the longest ORNAC animation finishes (or the
       reduced-motion equivalent fires immediately), persist the flag so
       subsequent visits skip the run-in entirely (see head-meta.njk gate). */
    (function () {
        try {
            if (localStorage.getItem('vornac_logo_intro_played') === '1') return;
        } catch (e) {}
        var mark = function () {
            try { localStorage.setItem('vornac_logo_intro_played', '1'); } catch (e) {}
            document.documentElement.classList.add('logo-intro-played');
        };
        var letters = document.querySelectorAll('.nav-logo-svg .v-logo-letter');
        var last = letters[letters.length - 1];
        if (last) {
            last.addEventListener('animationend', mark, { once: true });
            /* Safety net — set after the full 2.6s + delays even if the event
               doesn't fire (e.g. tab inactive during the animation window). */
            setTimeout(mark, 3600);
        } else {
            mark();
        }
    })();

    (function () {
        var logo = document.querySelector('.v-dv-logo');
        var spacer = document.querySelector('.v-dv-logo-spacer');
        var sticky = document.getElementById('sticky-nav');
        var stickyBtn = sticky ? sticky.querySelector('.v-dv-burger') : null;
        var topBurger = document.querySelector('.v-dv-burger--top');
        if (!logo || !spacer) return;

        var STICK_TOP = 14;
        var REVEAL = 1.5; // viewport heights before the sticky burger appears

        function luminance(rgb) {
            var m = rgb.match(/\d+(\.\d+)?/g);
            if (!m) return 1;
            var r = m[0] / 255, g = m[1] / 255, b = m[2] / 255;
            return 0.2126 * r + 0.7152 * g + 0.0722 * b;
        }

        // Nav chrome is taken out of hit-testing while sampling so we read the
        // section *behind* it, not the (transparent) logo/bar over the body.
        var chrome = [logo, sticky, topBurger, document.getElementById('site-header')].filter(Boolean);

        // Effective background luminance at a viewport point (walks up to the
        // first non-transparent background). Returns 1 (light) as a fallback.
        //
        // Special case: inside .method (the dark methodology section), there's
        // a live anime.js loop that toggles border/background colours on the
        // .method-stage cards. Sampling those animated layers makes the burger
        // and logo colour flicker. So if any ancestor is .method, we jump
        // straight to that section's own background and ignore the children.
        function bgLumAt(x, y) {
            var prev = chrome.map(function (el) { return el.style.pointerEvents; });
            chrome.forEach(function (el) { el.style.pointerEvents = 'none'; });
            var el = document.elementFromPoint(x, y);
            chrome.forEach(function (e, i) { e.style.pointerEvents = prev[i]; });

            // Short-circuit: if the hit point is inside the methodology
            // section, use its stable section background, not the animated
            // children inside it.
            var methodEl = el && el.closest ? el.closest('.method') : null;
            if (methodEl) {
                var bgM = getComputedStyle(methodEl).backgroundColor;
                if (bgM && bgM !== 'transparent' && !/rgba\([^)]*,\s*0\)/.test(bgM)) {
                    return luminance(bgM);
                }
            }

            while (el) {
                var bg = getComputedStyle(el).backgroundColor;
                if (bg && bg !== 'transparent' && !/rgba\([^)]*,\s*0\)/.test(bg)) {
                    return luminance(bg);
                }
                el = el.parentElement;
            }
            return 1;
        }

        // Multi-point sample around an element's box, return the median
        // luminance. Single-pixel sampling flickers at section boundaries;
        // sampling the four corners + centre gives a stable read even when
        // the burger sits exactly on a section seam.
        function bgLumAround(rect) {
            var pad = 4;
            var pts = [
                [rect.left + pad,            rect.top + pad],
                [rect.right - pad,           rect.top + pad],
                [rect.left + pad,            rect.bottom - pad],
                [rect.right - pad,           rect.bottom - pad],
                [rect.left + rect.width / 2, rect.top + rect.height / 2]
            ];
            var lums = pts.map(function (p) { return bgLumAt(Math.round(p[0]), Math.round(p[1])); });
            lums.sort(function (a, b) { return a - b; });
            return lums[2]; // median of 5
        }

        function inkFor(lum) { return lum < 0.5 ? '#ffffff' : '#0E1116'; }

        function update() {
            var r = spacer.getBoundingClientRect();
            var top = Math.max(STICK_TOP, Math.round(r.top));
            logo.style.left = Math.round(r.left) + 'px';
            logo.style.top = top + 'px';

            // Adaptive colour for the logo — sample around its box, take median.
            var logoRect = logo.getBoundingClientRect();
            logo.style.color = inkFor(bgLumAround(logoRect));

            var isMobile = window.matchMedia('(max-width: 1023px)').matches;

            // Sticky burger: desktop-only. On mobile (≤1023px) it's hidden
            // via CSS; skip all updates so we don't sample a hidden element.
            if (sticky && !isMobile) {
                var show = window.scrollY > window.innerHeight * REVEAL;
                sticky.classList.toggle('is-visible', show);
                sticky.setAttribute('aria-hidden', show ? 'false' : 'true');
                if (stickyBtn) stickyBtn.tabIndex = show ? 0 : -1;
                if (show && stickyBtn && !document.body.classList.contains('nav-open')) {
                    sticky.style.color = inkFor(bgLumAround(stickyBtn.getBoundingClientRect()));
                }
            }

            // Mobile: .v-dv-burger--top is pinned (position: fixed) and is
            // the only burger. Re-colour it on scroll like the desktop sticky
            // burger so it stays legible over both light and dark sections.
            if (isMobile && topBurger && !document.body.classList.contains('nav-open')) {
                topBurger.style.color = inkFor(bgLumAround(topBurger.getBoundingClientRect()));
            }
        }

        var ticking = false;
        function onScroll() {
            if (!ticking) {
                requestAnimationFrame(function () { update(); ticking = false; });
                ticking = true;
            }
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        window.addEventListener('load', update);
        update();
    })();
</script>
