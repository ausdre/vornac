        }
        body:not(.logo-intro-played) .nav-logo-svg .v-logo-letter {
            animation: vLogoLetter 2.6s cubic-bezier(.86, 0, .07, 1) both;
            animation-delay: calc(.25s + var(--i, 0) * .13s);
        }
    }
