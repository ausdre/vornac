{# Sticky site header — desktop nav + mobile drawer.

   The "active" nav link is detected from the page's i18nKey.
   Nav targets are pulled from pageUrls (auto-localized).
   Mobile menu logic lives in partials/cookie-script.njk (one DOMContentLoaded block).
#}

{# Macro: render a nav link with active-state styling. #}
{% macro navLink(linkKey, label, isActiveOverride) %}
  {% set isActive = isActiveOverride if isActiveOverride is defined else (i18nKey == linkKey) %}
  {% set href = pageUrls[linkKey] %}
  {% if isActive %}
    <a href="{{ href }}" class="nav-link text-white font-semibold border-b-2 border-amber-500">{{ label }}</a>
  {% else %}
    <a href="{{ href }}" class="nav-link text-white/65 hover:text-white transition-colors">{{ label }}</a>
  {% endif %}
{% endmacro %}

{# Macro: mobile drawer link. #}
{% macro mobileLink(linkKey, label) %}
  {% set isActive = (i18nKey == linkKey) %}
  {% set href = pageUrls[linkKey] %}
  {% if isActive %}
    <a href="{{ href }}" class="mobile-link text-lg font-medium text-amber-600">{{ label }}</a>
  {% else %}
    <a href="{{ href }}" class="mobile-link text-lg font-medium text-stone-600 hover:text-stone-900">{{ label }}</a>
  {% endif %}
{% endmacro %}

<header id="site-header" class="sticky top-0 z-50 px-3 pt-3 sm:px-5 sm:pt-4">
    <nav class="v-nav mx-auto flex max-w-content items-center justify-between rounded-[21px] px-5 py-2.5 shadow-[0_8px_30px_rgba(0,0,0,0.18)] backdrop-blur-sm backdrop-saturate-150 lg:px-7">

        <a href="{{ pageUrls.index }}" class="flex items-center gap-3" aria-label="{{ t.a11y.siteHome }}">
            {# Inline logo SVG (instead of <img>) so the intro reveal can animate the
               V mark and the ORNAC wordmark independently. Behaviour mirrors the
               dataveyes.com mark: leading mark appears, holds, then the wordmark
               sweeps in left→right with the same cubic-bezier(.86,0,.07,1) easing. #}
            <svg class="nav-logo nav-logo-svg h-12 w-auto sm:h-14" viewBox="0 0 1448 208" xmlns="http://www.w3.org/2000/svg" shape-rendering="geometricPrecision" aria-hidden="true" focusable="false">
                <defs>
                    <linearGradient id="vLogoGrad" x1="339.35" x2="339.35" y1="894.62" y2="1102.62" gradientTransform="matrix(.48429 -.87489 1.06616 .90262 -1217.88 -510.577)" gradientUnits="userSpaceOnUse">
                        <stop offset="0" stop-color="#fff"/><stop offset=".26" stop-color="#fff"/><stop offset=".52" stop-color="#fff"/><stop offset=".7" stop-color="#fff" stop-opacity=".04"/><stop offset=".88" stop-color="#fff" stop-opacity="0"/><stop offset=".88" stop-color="#fff"/><stop offset="1" stop-color="#fff"/>
                    </linearGradient>
                </defs>
                <path class="v-logo-mark" fill="url(#vLogoGrad)" fill-rule="evenodd" d="M0 0h50.1l67 126L187.09 0h49L114.06 207.74z" clip-rule="evenodd"/>
                <path class="v-logo-word" fill="#fff" fill-rule="evenodd" d="M297.22 43.48h125l-.11 121.34H297.22zm-1-43.45-44.99 43.45.17 121.34 44.82 42.92h125l44.69-42.92.18-121.34L421.22.03zm212.99 0L670.06 0l41 42v58l-29 27-9 7h-8l55.87 73.74H669.2l-95-115.71h90v-48l-109.99-1v164.71h-45zM754.05 0l149.99 122.03L904 0h41.1l-.06 208.03-147.99-122v121.71h-43zm340.8 0 127.34 207.74h-166.16l23-42.74h69l-52-89-77.26 131.74h-50.73zm178.17 0H1448l-40.99 43-135.99.48V162l4 2.82h130.99l41.99 42.92h-175.98l-44.53-42.92-.6-121.34z" clip-rule="evenodd"/>
            </svg>
        </a>

        <div class="hidden items-center gap-8 text-sm md:flex">
            {{ navLink('index', t.nav.home) }}
            {{ navLink('pentesting', t.nav.pentesting) }}
            {{ navLink('industries', t.nav.industries) }}
            {{ navLink('customers', t.nav.customers) }}

            {# About dropdown — active if any /about-* page or i18nKey 'about'. #}
            {% set aboutActive = (i18nKey == 'about') %}
            <div class="relative group">
                <button class="nav-link {{ 'text-white font-semibold border-b-2 border-amber-500' if aboutActive else 'text-white/65 hover:text-white transition-colors' }} flex items-center gap-1">
                    {{ t.nav.about }}
                    <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                </button>
                <div class="absolute left-0 mt-2 w-48 bg-white border border-stone-200 shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
                    <a href="{{ pageUrls.about }}#{{ t.aboutAnchors.company }}" class="block px-4 py-3 text-stone-700 hover:bg-stone-50 hover:text-stone-900 transition-colors">{{ t.nav.company }}</a>
                    <a href="{{ pageUrls.about }}#{{ t.aboutAnchors.careers }}" class="block px-4 py-3 text-stone-700 hover:bg-stone-50 hover:text-stone-900 transition-colors border-t border-stone-100">{{ t.nav.careers }}</a>
                </div>
            </div>

            <a href="{{ site.contact.bookDemo }}" class="bg-amber-500 uppercase tracking-widest hover:bg-amber-400 transition-colors duration-200" style="border-radius: 99999px 55550px 99999px 55550px; font-family: 'Archivo'; font-style: italic; font-weight: 900; color: rgba(0,0,0,0.75); letter-spacing: -0.65px; font-size: larger; padding: 0.5rem 1.5rem;">Validate<span style="font-style: oblique; font-family: 'Saira Condensed'; color: rgba(255,255,255,0.75); letter-spacing: .15px; font-size: 1.15rem; font-weight: 900; vertical-align: bottom;"> Now</span></a>
        </div>

        <button id="nav-toggle" class="relative z-[110] inline-flex h-10 w-10 items-center justify-center border border-white/40 md:hidden" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
            <span class="flex flex-col gap-1.5">
                <span class="block h-[2px] w-5 bg-white"></span>
                <span class="block h-[2px] w-5 bg-white"></span>
                <span class="block h-[2px] w-5 bg-white"></span>
            </span>
        </button>
    </nav>

    <div id="mobile-backdrop" class="fixed inset-0 z-[90] hidden bg-black/50 backdrop-blur-sm md:hidden"></div>

    <div id="mobile-menu" class="fixed left-3 right-3 top-[84px] z-[100] hidden rounded-2xl border border-stone-200 bg-white/95 shadow-xl backdrop-blur-xl md:hidden">
        <div class="flex flex-col space-y-6 px-8 py-10 text-center">
            {{ mobileLink('index', t.nav.home) }}
            {{ mobileLink('pentesting', t.nav.pentesting) }}
            {{ mobileLink('industries', t.nav.industries) }}
            {{ mobileLink('customers', t.nav.customers) }}
            <div class="flex flex-col">
                <button onclick="this.nextElementSibling.classList.toggle('hidden')" class="mobile-link text-lg font-medium text-stone-600 hover:text-stone-900 flex items-center justify-center gap-2">
                    {{ t.nav.about }}
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                </button>
                <div class="hidden flex flex-col space-y-3 mt-3 px-4">
                    <a href="{{ pageUrls.about }}#{{ t.aboutAnchors.company }}" class="text-base text-stone-500 hover:text-stone-900">→ {{ t.nav.company }}</a>
                    <a href="{{ pageUrls.about }}#{{ t.aboutAnchors.careers }}" class="text-base text-stone-500 hover:text-stone-900">→ {{ t.nav.careers }}</a>
                </div>
            </div>
            <a href="{{ site.contact.bookDemo }}" class="mobile-link mt-4 flex h-14 items-center justify-center bg-stone-900 font-bold text-white transition-colors active:bg-amber-700 hover:bg-amber-600">{{ t.nav.bookDemo }}</a>
        </div>
    </div>
</header>

<style>
    /* Logo intro reveal — adapted from the dataveyes.com mark behaviour.
       Two-beat sweep: the V mark fades in and holds alone, then the ORNAC
       wordmark wipes in left→right. The clip-path is sized so 0–16% of the
       logo (the V) shows first, matching the V's share of the viewBox. */
    .nav-logo-svg { display: block; will-change: clip-path, opacity; }
    @media (prefers-reduced-motion: no-preference) {
        .nav-logo-svg { animation: vLogoReveal 1.6s cubic-bezier(.86, 0, .07, 1) both; }
    }
    @keyframes vLogoReveal {
        0%   { clip-path: inset(0 100% 0 0); opacity: 0; }
        10%  { opacity: 1; }
        22%  { clip-path: inset(0 84% 0 0); }
        40%  { clip-path: inset(0 84% 0 0); }
        100% { clip-path: inset(0 0 0 0); opacity: 1; }
    }
</style>

<script>
    (function () {
        var header = document.getElementById('site-header');
        if (!header) return;
        var sync = function () {
            header.classList.toggle('is-scrolled', window.scrollY > 8);
        };
        sync();
        window.addEventListener('scroll', sync, { passive: true });
    })();
</script>
