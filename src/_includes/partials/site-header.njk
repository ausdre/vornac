{# Site header — Dataveyes-style navbar with a sticky logo + sticky burger.

   Behaviour modelled on dataveyes.com:
   - Logo is permanently sticky: it sits in the top bar, then stays pinned near
     the viewport top as you scroll (a fixed element whose top tracks the bar,
     then clamps). Its colour adapts (white over dark sections, ink over light)
     so it never vanishes over our white sections.
   - The top bar (nav links + lang + Validate Now on desktop, burger on mobile)
     scrolls away with the page.
   - A sticky burger slides down from the top with a subtle animation once you
     scroll past ~1.5 viewport heights; it opens the full-screen overlay menu.
   - Keeps the announcement bar and the run-in → collapse-to-V logo intro.

   Positioning + colour adaptation + sticky-burger reveal live in the script
   below. Menu open/close (shared by both burgers) lives in site-scripts.njk.
#}

{% macro burgerIcon() %}
<svg width="22" height="22" viewBox="0 0 18 18" fill="none" aria-hidden="true">
    <rect class="v-dv-burger-top" fill="currentColor" height="2" width="18" y="2"/>
    <rect class="v-dv-burger-mid" fill="currentColor" height="2" width="9" y="8"/>
    <rect class="v-dv-burger-bot" fill="currentColor" height="2" width="18" y="14"/>
</svg>
{% endmacro %}

{# Desktop nav link — current page is dimmed, like the dataveyes nav. #}
{% macro navLink(linkKey, label) %}
  {% set isActive = (i18nKey == linkKey) %}
  <a href="{{ pageUrls[linkKey] }}" class="v-dv-link{% if isActive %} is-active{% endif %}"{% if isActive %} aria-current="page"{% endif %}>{{ label }}</a>
{% endmacro %}

{# Desktop dropdown trigger — landing-page link with a chevron. The full
   submenu (children + section heading) is composed inline at call site.
   The trigger is dimmed when the visitor is either on its landing page OR
   on one of its children (e.g. `/research/cloud-infrastructure`). Only the
   exact landing page gets `aria-current="page"` — child pages get their
   own aria-current on the matching dropdown link. #}
{% macro dropTrigger(linkKey, label) %}
  {% set isExact = (i18nKey == linkKey) %}
  {% set isChild = (linkKey == 'research' and i18nKey and 'research' in i18nKey and not isExact) or (linkKey == 'industries' and i18nKey and 'industries' in i18nKey and not isExact) %}
  {% set isActive = isExact or isChild %}
  <a href="{{ pageUrls[linkKey] }}" class="v-dv-link v-dv-drop-trigger{% if isActive %} is-active{% endif %}"{% if isExact %} aria-current="page"{% endif %}>
    {{ label }}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
  </a>
{% endmacro %}

{# Mobile overlay link — large heading style. #}
{% macro mobileLink(linkKey, label) %}
  {% set isActive = (i18nKey == linkKey) %}
  <a href="{{ pageUrls[linkKey] }}" class="v-dv-mlink{% if isActive %} is-active{% endif %}"{% if isActive %} aria-current="page"{% endif %}>{{ label }}</a>
{% endmacro %}

{# Mobile overlay sub-link — small, plain, indented under its parent. #}
{% macro mobileSub(href, label, sub, isActive) %}
  <a href="{{ href }}" class="v-dv-msub{% if isActive %} is-active{% endif %}"{% if isActive %} aria-current="page"{% endif %}>
    <span class="v-dv-msub-label">{{ label }}</span>
    {% if sub %}<span class="v-dv-msub-sub">{{ sub }}</span>{% endif %}
  </a>
{% endmacro %}

{# In-flow top bar — scrolls away with the page. Three-zone grid like the
   dataveyes top bar: a logo spacer on the left, centered primary nav, and
   utility actions (lang switch + CTA) on the right. All zones top-align so
   the logo's top edge sits on the same line as the nav text and lang. #}
<header id="site-header" class="v-dv-topbar">
    <span class="v-dv-logo-spacer" aria-hidden="true"></span>

    <nav class="v-dv-nav" aria-label="Primary">
        {{ navLink('index', t.nav.home) }}
        {{ navLink('pentesting', t.nav.pentesting) }}

        {# ─── Industries dropdown ─── #}
        <div class="v-dv-drop" id="nav-industries">
            {{ dropTrigger('industries', t.nav.industries) }}
            <div class="v-dv-drop-panel">
                <div class="v-dv-drop-inner">
                    <span class="v-dv-drop-heading">{{ t.navHeadings.industries }}</span>
                    <ul class="v-dv-drop-list">
                        {% for ind in t.industriesNav %}
                          {% set indActive = (i18nKey == ind.key) %}
                          <li>
                              <a href="{{ pageUrls[ind.key] }}" class="v-dv-drop-link{% if indActive %} is-active{% endif %}"{% if indActive %} aria-current="page"{% endif %}>
                                  <span class="v-dv-drop-link-label">{{ ind.label }}</span>
                                  <span class="v-dv-drop-link-meta">{{ ind.fw }}</span>
                              </a>
                          </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>

        {{ navLink('customers', t.nav.customers) }}

        {# ─── Research dropdown ─── #}
        <div class="v-dv-drop v-dv-drop--wide" id="nav-research">
            {{ dropTrigger('research', t.nav.research) }}
            <div class="v-dv-drop-panel v-dv-drop-panel--wide">
                <div class="v-dv-drop-inner v-dv-drop-inner--cols">
                    <div class="v-dv-drop-col">
                        <span class="v-dv-drop-heading">{{ t.navHeadings.research }}</span>
                        <ul class="v-dv-drop-list v-dv-drop-list--grid">
                            {% for d in research.domains %}
                              {% set dActive = (i18nKey == ('research-' + d.id)) %}
                              <li>
                                  <a href="/{% if locale == 'de' %}de/{% endif %}research/{{ d.id }}/" class="v-dv-drop-link{% if dActive %} is-active{% endif %}"{% if dActive %} aria-current="page"{% endif %}>
                                      <span class="v-dv-drop-link-num">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span>
                                      <span class="v-dv-drop-link-label">{{ d.title[locale] }}</span>
                                  </a>
                              </li>
                            {% endfor %}
                        </ul>
                    </div>
                    <div class="v-dv-drop-aside">
                        <span class="v-dv-drop-heading">{{ t.navHeadings.glossary }}</span>
                        <a href="{{ pageUrls.glossary }}" class="v-dv-drop-aside-link{% if i18nKey == 'glossary' %} is-active{% endif %}">
                            {{ t.nav.glossary }}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M13 5l7 7-7 7"/></svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        {# ─── About dropdown (right-anchored — it's the rightmost group) ─── #}
        <div class="v-dv-drop v-dv-drop--right" id="nav-about">
            {{ dropTrigger('about', t.nav.about) }}
            <div class="v-dv-drop-panel v-dv-drop-panel--right">
                <div class="v-dv-drop-inner">
                    <span class="v-dv-drop-heading">{{ t.navHeadings.about }}</span>
                    <ul class="v-dv-drop-list">
                        <li><a href="{{ pageUrls.about }}#{{ t.aboutAnchors.company }}" class="v-dv-drop-link"><span class="v-dv-drop-link-label">{{ t.nav.company }}</span></a></li>
                        <li><a href="{{ pageUrls.about }}#{{ t.aboutAnchors.careers }}" class="v-dv-drop-link"><span class="v-dv-drop-link-label">{{ t.nav.careers }}</span></a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    {# Right zone — utility actions (lang switch + Validate Now CTA). #}
    <div class="v-dv-utility">
        {% if counterpart %}
        <span class="v-dv-lang" role="navigation" aria-label="{{ t.a11y.langNav }}">
            {% if locale == 'en' %}
                <span class="is-active" aria-current="true">EN</span><span class="v-dv-lang-sep" aria-hidden="true">/</span><a href="{{ counterpart }}?lang=de" hreflang="de" onclick="localStorage.setItem('vornac_lang','de')">DE</a>
            {% else %}
                <span class="is-active" aria-current="true">DE</span><span class="v-dv-lang-sep" aria-hidden="true">/</span><a href="{{ counterpart }}?lang=en" hreflang="en" onclick="localStorage.setItem('vornac_lang','en')">EN</a>
            {% endif %}
        </span>
        {% endif %}

        <a href="{{ site.contact.bookDemo }}" class="v-dv-cta bg-amber-500 uppercase tracking-widest hover:bg-amber-400 transition-colors duration-200" style="border-radius: 99999px 55550px 99999px 55550px; font-family: 'Archivo'; font-style: italic; font-weight: 900; color: rgba(0,0,0,0.75); letter-spacing: -0.65px; font-size: larger; padding: 0.5rem 1.5rem;">Validate<span style="font-style: oblique; font-family: 'Saira Condensed'; color: rgba(255,255,255,0.75); letter-spacing: .15px; font-size: 1.15rem; font-weight: 900; vertical-align: bottom;"> Now</span></a>
    </div>

    {# Burger for the top state (mobile only) — scrolls away with the bar. #}
    <button class="v-dv-burger v-dv-burger--top" data-nav-toggle aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
        {{ burgerIcon() }}
    </button>
</header>

{# Sticky logo — fixed; the script keeps it over the spacer, then pinned near
   the top. Inline SVG so the intro can animate the V mark + each ORNAC letter
   (run in from the right, hold as VORNAC, then vanish to the V monogram). #}
<a href="{{ pageUrls.index }}" class="v-dv-logo" aria-label="{{ t.a11y.siteHome }}">
    <svg class="nav-logo-svg" viewBox="0 0 1448 208" xmlns="http://www.w3.org/2000/svg" shape-rendering="geometricPrecision" aria-hidden="true" focusable="false">
        <defs>
            <linearGradient id="vLogoGrad" x1="339.35" x2="339.35" y1="894.62" y2="1102.62" gradientTransform="matrix(.48429 -.87489 1.06616 .90262 -1217.88 -510.577)" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="currentColor"/><stop offset=".26" stop-color="currentColor"/><stop offset=".52" stop-color="currentColor"/><stop offset=".7" stop-color="currentColor" stop-opacity=".04"/><stop offset=".88" stop-color="currentColor" stop-opacity="0"/><stop offset=".88" stop-color="currentColor"/><stop offset="1" stop-color="currentColor"/>
            </linearGradient>
        </defs>
        <path class="v-logo-mark" fill="url(#vLogoGrad)" fill-rule="evenodd" d="M0 0h50.1l67 126L187.09 0h49L114.06 207.74z" clip-rule="evenodd"/>
        <g class="v-logo-word" fill="currentColor" fill-rule="evenodd">
            <path class="v-logo-letter" style="--i:0" d="M297.22 43.48L422.22 43.48L422.11 164.82L297.22 164.82ZM296.22 0.03L251.23 43.48L251.4 164.82L296.22 207.74L421.22 207.74L465.91 164.82L466.09 43.48L421.22 0.03Z"/>
            <path class="v-logo-letter" style="--i:1" d="M509.21 0.03L670.06 0L711.06 42L711.06 100L682.06 127L673.06 134L665.06 134L720.93 207.74L669.2 207.74L574.2 92.03L664.2 92.03L664.2 44.03L554.21 43.03L554.21 207.74L509.21 207.74Z"/>
            <path class="v-logo-letter" style="--i:2" d="M754.05 0L904.04 122.03L904 0L945.1 0L945.04 208.03L797.05 86.03L797.05 207.74L754.05 207.74Z"/>
            <path class="v-logo-letter" style="--i:3" d="M1094.85 0L1222.19 207.74L1056.03 207.74L1079.03 165L1148.03 165L1096.03 76L1018.77 207.74L968.04 207.74Z"/>
            <path class="v-logo-letter" style="--i:4" d="M1273.02 0L1448 0L1407.01 43L1271.02 43.48L1271.02 162L1275.02 164.82L1406.01 164.82L1448 207.74L1272.02 207.74L1227.49 164.82L1226.89 43.48Z"/>
        </g>
    </svg>
</a>

{# Sticky burger — slides down from the top after ~1.5 pages of scroll. #}
<div id="sticky-nav" class="v-dv-sticky">
    <button class="v-dv-burger v-dv-burger--sticky" data-nav-toggle aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
        {{ burgerIcon() }}
    </button>
</div>

<div id="mobile-backdrop" class="v-dv-backdrop hidden"></div>

{# Full-screen overlay revealed by the burger. Layout: header (V mark + close
   X) → scrollable nav body → sticky footer (lang + Validate Now). Each
   parent section gets its own group with a small mono caption heading; the
   sub-list sits below in a tidy column with `· FRAMEWORK` tags inline. #}
<div id="mobile-menu" class="v-dv-menu hidden" role="dialog" aria-modal="true" aria-label="{{ t.a11y.menuLabel or 'Menu' }}">
    <div class="v-dv-menu-shell">
        <header class="v-dv-menu-head">
            <a href="{{ pageUrls.index }}" class="v-dv-menu-logo" aria-label="{{ t.a11y.siteHome }}">
                <svg viewBox="0 0 240 208" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                    <path fill="currentColor" d="M0 0h50.1l67 126L187.09 0h49L114.06 207.74z"/>
                </svg>
            </a>
            <button type="button" class="v-dv-menu-close" data-nav-toggle aria-label="{{ t.a11y.closeMenu or 'Close menu' }}">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </header>

        <nav class="v-dv-menu-nav" aria-label="Mobile">
            <div class="v-dv-mgroup v-dv-mgroup--solo">
                {{ mobileLink('index', t.nav.home) }}
                {{ mobileLink('pentesting', t.nav.pentesting) }}
                {{ mobileLink('customers', t.nav.customers) }}
            </div>

            <div class="v-dv-mgroup v-dv-mgroup--ind">
                <button type="button" class="v-dv-mhead v-dv-mhead--toggle" data-mobile-collapse aria-controls="mnav-ind" aria-expanded="false">
                    <span>{{ t.navHeadings.industries }}</span>
                    <svg class="v-dv-mhead-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <ul class="v-dv-msubs" id="mnav-ind" hidden>
                    <li><a href="{{ pageUrls.industries }}" class="v-dv-msub v-dv-msub--index{% if i18nKey == 'industries' %} is-active{% endif %}"{% if i18nKey == 'industries' %} aria-current="page"{% endif %}>
                        <span class="v-dv-msub-label">{{ t.navOverview }}</span>
                        <span class="v-dv-msub-sub">{{ t.industriesNav | length }}</span>
                    </a></li>
                    {% for ind in t.industriesNav %}
                      {{ mobileSub(pageUrls[ind.key], ind.label, ind.fw, i18nKey == ind.key) }}
                    {% endfor %}
                </ul>
            </div>

            <div class="v-dv-mgroup v-dv-mgroup--research">
                <button type="button" class="v-dv-mhead v-dv-mhead--toggle" data-mobile-collapse aria-controls="mnav-res" aria-expanded="false">
                    <span>{{ t.navHeadings.research }}</span>
                    <svg class="v-dv-mhead-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <ul class="v-dv-msubs" id="mnav-res" hidden>
                    <li><a href="{{ pageUrls.research }}" class="v-dv-msub v-dv-msub--index{% if i18nKey == 'research' %} is-active{% endif %}"{% if i18nKey == 'research' %} aria-current="page"{% endif %}>
                        <span class="v-dv-msub-label">{{ t.navResearchHome }}</span>
                        <span class="v-dv-msub-sub">{{ research.domains | length }}</span>
                    </a></li>
                    {% for d in research.domains %}
                      {% set dHref = "/" + ("de/" if locale == "de" else "") + "research/" + d.id + "/" %}
                      {{ mobileSub(dHref, d.title[locale], "", i18nKey == ("research-" + d.id)) }}
                    {% endfor %}
                    {{ mobileSub(pageUrls.glossary, t.nav.glossary, t.navHeadings.glossary, i18nKey == 'glossary') }}
                </ul>
            </div>

            <div class="v-dv-mgroup v-dv-mgroup--about">
                <button type="button" class="v-dv-mhead--toggle" data-mobile-collapse aria-controls="mnav-about" aria-expanded="false">
                    <span>{{ t.navHeadings.about }}</span>
                    <svg class="v-dv-mhead-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <ul class="v-dv-msubs" id="mnav-about" hidden>
                    {{ mobileSub(pageUrls.about + "#" + t.aboutAnchors.company, t.nav.company, "", false) }}
                    {{ mobileSub(pageUrls.about + "#" + t.aboutAnchors.careers, t.nav.careers, "", false) }}
                </ul>
            </div>

        </nav>

        <div class="v-dv-menu-foot">
            <div class="v-dv-menu-legal" aria-label="{{ t.navHeadings.legal }}">
                <a href="{{ pageUrls.legal }}#{{ t.legalAnchors.imprint }}">{{ t.footer.legalLinks.imprint }}</a>
                <span class="v-dv-menu-legal-sep" aria-hidden="true">·</span>
                <a href="{{ pageUrls.legal }}#{{ t.legalAnchors.privacy }}">{{ t.footer.legalLinks.privacy }}</a>
            </div>
            <div class="v-dv-menu-utility">
                {% if counterpart %}
                <span class="v-dv-lang v-dv-menu-lang" role="navigation" aria-label="{{ t.a11y.langNav }}">
                    {% if locale == 'en' %}
                        <span class="is-active" aria-current="true">EN</span><span class="v-dv-lang-sep" aria-hidden="true">/</span><a href="{{ counterpart }}?lang=de" hreflang="de" onclick="localStorage.setItem('vornac_lang','de')">DE</a>
                    {% else %}
                        <span class="is-active" aria-current="true">DE</span><span class="v-dv-lang-sep" aria-hidden="true">/</span><a href="{{ counterpart }}?lang=en" hreflang="en" onclick="localStorage.setItem('vornac_lang','en')">EN</a>
                    {% endif %}
                </span>
                {% endif %}
                <a href="{{ site.contact.bookDemo }}" class="v-dv-cta bg-amber-500 uppercase tracking-widest hover:bg-amber-400 transition-colors duration-200" style="border-radius: 99999px 55550px 99999px 55550px; font-family: 'Archivo'; font-style: italic; font-weight: 900; color: rgba(0,0,0,0.75); letter-spacing: -0.65px; font-size: larger; padding: 0.6rem 1.7rem;">Validate<span style="font-style: oblique; font-family: 'Saira Condensed'; color: rgba(255,255,255,0.75); letter-spacing: .15px; font-size: 1.15rem; font-weight: 900; vertical-align: bottom;"> Now</span></a>
            </div>
        </div>
    </div>
</div>

<style>
    /* ── Top bar (in-flow, scrolls away) ─────────────────────────────────
       Three-zone grid: logo spacer (left) — primary nav (centered) — utility
       (lang + CTA, right). All zones align at the TOP edge so the logo's top
       sits on the same line as the first row of nav text and the lang switch,
       mirroring dataveyes.com. */
    .v-dv-topbar {
        position: relative;
        z-index: 50;
        max-width: 1320px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: start;
        gap: 28px;
        padding: 22px 32px 14px;
        color: #0E1116;
    }
    body.v-home .v-dv-topbar { color: #fff; }

    .v-dv-logo-spacer { flex: none; width: clamp(150px, 20vw, 240px); aspect-ratio: 1448 / 208; }

    /* Sticky logo (fixed; positioned by the script). Colour is set inline by
       the script per the section behind it; this is just the pre-JS baseline. */
    .v-dv-logo {
        position: fixed;
        top: 22px;
        left: 32px;
        z-index: 55;
        width: clamp(150px, 20vw, 240px);
        color: #0E1116;
        will-change: top, left;
    }
    body.v-home .v-dv-logo { color: #fff; }
    .nav-logo-svg { display: block; width: 100%; height: auto; }

    /* Primary nav — centered group of section links. Wraps onto a second
       row on narrower viewports so it can stay centered without crowding. */
    .v-dv-nav {
        display: flex;
        align-items: baseline;
        justify-content: center;
        flex-wrap: wrap;
        column-gap: 30px;
        row-gap: 6px;
        padding-top: 4px;
    }
    .v-dv-utility {
        display: flex;
        align-items: center;
        gap: 18px;
        padding-top: 2px;
    }
    .v-dv-link {
        position: relative;
        color: currentColor;
        font-family: var(--v-sans);
        font-size: 15px;
        font-weight: 400;
        line-height: 1.4;
        text-decoration: none;
        white-space: nowrap;
        transition: opacity .2s ease;
    }
    .v-dv-link:hover { opacity: .6; }
    .v-dv-link.is-active { opacity: .45; }   /* current page dimmed, like dataveyes */

    /* ── Mega-menu dropdowns (Research, Industries, About) ──────────────
       Dataveyes idiom: plain text, no chrome, dim/active states only.
       The panel sits on a dark surface so it reads cleanly over both the
       white interior pages and the dark home hero. A small 1px amber
       hairline pinned to the trigger marks the active group, mirroring
       dataveyes' minimalist underline pattern. */
    .v-dv-drop { position: relative; }
    .v-dv-drop-trigger { display: inline-flex; align-items: center; gap: 5px; }
    .v-dv-drop-trigger svg { width: 12px; height: 12px; transition: transform .25s ease; opacity: .55; }
    .v-dv-drop:hover .v-dv-drop-trigger svg,
    .v-dv-drop:focus-within .v-dv-drop-trigger svg { transform: rotate(180deg); opacity: 1; }

    /* The dropdown bridges the gap to the trigger via a 16px invisible
       top padding so the cursor doesn't drop out between trigger and panel. */
    .v-dv-drop-panel {
        position: absolute;
        left: -28px;
        top: 100%;
        padding-top: 16px;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-4px);
        transition: opacity .22s ease, transform .22s ease, visibility .22s;
        pointer-events: none;
    }
    .v-dv-drop:hover .v-dv-drop-panel,
    .v-dv-drop:focus-within .v-dv-drop-panel,
    .v-dv-drop.is-open .v-dv-drop-panel {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
        pointer-events: auto;
    }
    .v-dv-drop-inner {
        background: #0E1116;
        color: #fff;
        padding: 22px 26px 24px;
        min-width: 340px;
        box-shadow: 0 24px 60px -28px rgba(0, 0, 0, 0.45);
    }
    /* Research panel is wide; anchor to the right edge of the trigger so
       it doesn't spill out of the viewport on standard 1440 desktops. */
    .v-dv-drop-panel--wide,
    .v-dv-drop-panel--right {
        left: auto;
        right: -28px;
    }
    .v-dv-drop-inner--cols {
        display: grid;
        grid-template-columns: minmax(420px, 1fr) minmax(180px, 220px);
        gap: 48px;
        min-width: 640px;
        padding: 26px 30px 28px;
    }
    .v-dv-drop-heading {
        display: block;
        font-family: var(--v-mono);
        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.4);
        margin-bottom: 14px;
    }
    .v-dv-drop-list {
        list-style: none;
        margin: 0;
