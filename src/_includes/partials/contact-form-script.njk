{# Close interactions for the #thankyou-overlay modal on the index pages.
   The overlay is opened by hero-demo-script.njk after a successful hero-form
   submission; this script only wires up the close button and backdrop click.
   (A former Formspree submit handler for id="contact-form" was removed — that
   form no longer exists on any page.) #}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const thankyouOverlay = document.getElementById('thankyou-overlay');
    const thankyouClose = document.getElementById('thankyou-close');

    const closeThankyou = () => thankyouOverlay?.classList.remove('is-open');
    thankyouClose?.addEventListener('click', closeThankyou);
    thankyouOverlay?.addEventListener('click', (e) => {
        if (e.target === thankyouOverlay) closeThankyou();
    });
});
</script>
