{#
  Language preference (no automatic redirect).

  German is the root locale (/), English lives under /en. Visitors switch
  language with the header/footer switcher, which appends ?lang=<code>.
  We persist that choice for future features but never redirect
  automatically: crawlers and AI engines fetch the root URL without
  JavaScript and must always receive the German page, and Googlebot renders
  with an en-US locale, so a JS redirect on the root would make Google
  index the English page under the German URL.
#}
<script>
(function() {
  try {
    var params = new URLSearchParams(window.location.search);
    var urlLang = params.get('lang');
    if (urlLang === 'en' || urlLang === 'de') {
      localStorage.setItem('vornac_lang', urlLang);
    }
  } catch (e) {
    // localStorage disabled / privacy mode: no-op.
  }
})();
</script>
