{#
  Smart per-page language auto-redirect.

  Decision tree (runs in <head>, before render so there's no FOUC):

    1. URL has ?lang=en or ?lang=de  -> save it, stay.
    2. localStorage.vornac_lang is set  -> respect previous choice, no redirect.
    3. First-time visit, no preference set:
         - If on EN page AND navigator.language starts with "de" -> go to DE counterpart.
         - If on DE page AND navigator.language starts with "en" -> we *don't* redirect.
           Reason: visiting /de/* is usually intentional; a German company may have
           English-locale browsers and still want the German site. Showing them
           German on an explicit /de/ URL is correct.
    4. Save the resolved language so we never redirect this user again.

  Requires per-page counterpart URL via `counterpart` data var.
  Single-locale pages (counterpart === null) skip the redirect entirely.
#}
<script>
(function() {
  try {
    var counterpart = {% if counterpart %}{{ counterpart | dump | safe }}{% else %}null{% endif %};
    var pageLocale = {{ locale | dump | safe }};
    var params = new URLSearchParams(window.location.search);

    // 1. Explicit URL opt-in.
    var urlLang = params.get('lang');
    if (urlLang === 'en' || urlLang === 'de') {
      localStorage.setItem('vornac_lang', urlLang);
      return;
    }

    // 2. Respect previously-saved choice.
    var savedLang = localStorage.getItem('vornac_lang');
    if (savedLang) return;

    // Single-locale page: nothing to redirect to.
    if (!counterpart) return;

    // 3. First-time visit. Only redirect EN -> DE for German-speaking browsers.
    var userLang = (navigator.language || navigator.userLanguage || '').toLowerCase();
    if (pageLocale === 'en' && userLang.startsWith('de')) {
      localStorage.setItem('vornac_lang', 'de');
      // 4. Resolve to either local-dev path or production URL.
      var isLocal =
        location.hostname === 'localhost' ||
        location.hostname === '127.0.0.1' ||
        location.hostname === '[::1]';
      var target = counterpart;
      if (isLocal && target === '/de') target = '/de/index.html';
      window.location.replace(target);
      return;
    }

    // Persist the resolved (default) language so future first-time checks no-op.
    localStorage.setItem('vornac_lang', pageLocale);
  } catch (e) {
    // localStorage disabled / privacy mode: no-op, never break the page.
  }
})();
</script>
