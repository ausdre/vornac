{# Drives the /apply and /de/apply application form: position auto-select from
   ?position=, and the Formspree submission itself.

   Position option keys are locale-agnostic slugs that map to the <option value>
   strings in apply.njk / de/apply.njk. Slugs are union of EN + DE so a single
   script handles both pages.

   All user-visible copy lives in the page templates (#apply-success,
   #apply-error) so this script stays locale-neutral. Without JavaScript the
   form still posts to Formspree natively and lands on Formspree's own
   confirmation page.
#}
<script>
(function () {
    const urlParams = new URLSearchParams(window.location.search);
    const position = urlParams.get('position');
    if (position) {
        const select = document.getElementById('position-select');
        const options = {
            'head-of-sales':     ['Head of Sales'],
            'pentester-csm':     ['Pentester as CSM', 'Pentester als CSM'],
            'assistant':         ['Assistant'],
            'assistenz':         ['Assistenz'],
            'open-application':  ['Open Application'],
            'initiativbewerbung':['Initiativbewerbung']
        };
        if (select && options[position]) {
            for (const value of options[position]) {
                const found = Array.from(select.options).find(o => o.value === value);
                if (found) {
                    select.value = value;
                    break;
                }
            }
        }
    }

    const form = document.getElementById('apply-form');
    const formCard = document.getElementById('apply-form-card');
    const errorBox = document.getElementById('apply-error');
    const successBox = document.getElementById('apply-success');
    if (!form || !errorBox || !successBox) return;

    form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const gotcha = form.querySelector('[name="_gotcha"]');
        if (gotcha && gotcha.value) return;

        errorBox.classList.add('hidden');

        const button = form.querySelector('[type="submit"]');
        const buttonLabel = button ? button.textContent : '';
        if (button) {
            button.disabled = true;
            const sending = button.getAttribute('data-sending');
            if (sending) button.textContent = sending;
        }

        let ok = false;
        try {
            const response = await fetch(form.action, {
                method: 'POST',
                body: new FormData(form),
                headers: { Accept: 'application/json' }
            });
            ok = response.ok;
        } catch (err) {
            ok = false;
        }

        // Never report success we did not get: a failed send keeps the filled-in
        // form on screen with the error and the e-mail fallback.
        if (!ok) {
            if (button) {
                button.disabled = false;
                button.textContent = buttonLabel;
            }
            errorBox.classList.remove('hidden');
            errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
            return;
        }

        if (typeof gtag === 'function') {
            // Own event name rather than the generate_lead the demo and contact
            // forms send: applicants are not sales leads. For the same reason
            // neither the "Termin vereinbaren" Ads conversion nor the enhanced-
            // conversions user_data fire here.
            gtag('event', 'job_application', {
                send_to: 'G-9LJGWDQ2CR',
                form_location: 'apply_form'
            });
        }

        form.reset();
        if (formCard) formCard.classList.add('hidden');
        successBox.classList.remove('hidden');
        successBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
})();
</script>
