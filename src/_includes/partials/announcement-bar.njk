{# Top announcement bar — dark band with amber "Neu/New" tag #}
<div class="v-announcement">
    <div class="v-announcement-inner">
        <span class="v-announcement-tag">{{ t.announcement.tag }}</span>
        {{ t.announcement.body }}
        <a href="{{ t.announcement.ctaHref }}" target="_blank" rel="noopener">{{ t.announcement.cta }}</a>
    </div>
</div>
