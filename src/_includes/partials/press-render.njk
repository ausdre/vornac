{# Press page body, shared by src/de/press.njk and src/press.njk.
   Data from src/_data/press.js; strings from press.ui[locale].
   Inputs in scope: locale, press, pageUrls, site. #}
{% set ui = press.ui[locale] %}
<main class="press-page">

    <section class="ps-hero">
        <div class="ps-hero-inner">
            <h1 class="ps-hero-headline">{{ ui.h1 }}<span class="ps-period">.</span></h1>
            <p class="ps-hero-lead">{{ ui.lead }}</p>
            <div class="ps-contact" id="pressekontakt">
                <p class="ps-contact-heading">{{ ui.contactHeading }}</p>
                <p class="ps-contact-name">{{ press.contact.name }}</p>
                {% if press.contact.role[locale] %}<p class="ps-contact-role">{{ press.contact.role[locale] }}</p>{% endif %}
                <p class="ps-contact-links">
                    <a href="mailto:{{ press.contact.email }}">{{ press.contact.email }}</a>
                    <a href="tel:{{ press.contact.phone | replace(' ', '') }}">{{ press.contact.phoneDisplay }}</a>
                </p>
            </div>
        </div>
    </section>

    {% if press.awards.length %}
    <section class="ps-section" id="auszeichnungen">
        <div class="ps-section-inner">
            <header class="ps-head">
                <h2 class="ps-headline">{{ ui.awardsHeading }}</h2>
                <p class="ps-sub">{{ ui.awardsSub }}</p>
            </header>
            <div class="ps-awards">
                {% for a in press.awards %}
                <article class="ps-award">
                    <div class="ps-award-year" aria-hidden="true">{{ a.year }}</div>
                    <div>
                        <h3 class="ps-award-title">{{ a.title[locale] }}</h3>
                        <p class="ps-award-by">{{ a.by[locale] }}{% if a.dateLabel[locale] and a.date.length > 4 %} · <time datetime="{{ a.date }}">{{ a.dateLabel[locale] }}</time>{% endif %}</p>
                        <p class="ps-award-text">{{ a.text[locale] }}</p>
                        {% if a.url %}<a class="ps-link" href="{{ a.url }}" target="_blank" rel="noopener">{{ ui.awardLink }}</a>{% endif %}
                    </div>
                </article>
                {% endfor %}
            </div>
        </div>
    </section>
    {% endif %}

    {% if press.coverage.length %}
    <section class="ps-section" id="pressespiegel">
        <div class="ps-section-inner">
            <header class="ps-head">
                <h2 class="ps-headline">{{ ui.coverageHeading }}</h2>
                <p class="ps-sub">{{ ui.coverageSub }}</p>
            </header>
            <div class="ps-list">
                {% for c in press.coverage %}
                <article class="ps-item">
                    <time class="ps-item-date" datetime="{{ c.date }}">{{ c.dateLabel[locale] }}</time>
                    <div>
                        <p class="ps-item-outlet">{{ c.outlet }}</p>
                        <h3 class="ps-item-title">{% if c.url %}<a href="{{ c.url }}" target="_blank" rel="noopener"{% if c.lang and c.lang != locale %} hreflang="{{ c.lang }}"{% endif %}>{{ c.title }}</a>{% elif c.pdf %}<a href="{{ c.pdf }}" target="_blank" rel="noopener">{{ c.title }}</a>{% else %}{{ c.title }}{% endif %}</h3>
                        <p class="ps-item-meta">{{ press.types[c.type][locale] }}{% if c.author %}<span class="ps-dot" aria-hidden="true">·</span>{{ ui.by }} {{ c.author }}{% endif %}{% if c.cite %}<span class="ps-dot" aria-hidden="true">·</span>{{ c.cite }}{% endif %}{% if c.pdf and c.url %}<span class="ps-dot" aria-hidden="true">·</span><a href="{{ c.pdf }}" target="_blank" rel="noopener">{{ ui.coveragePdf }}</a>{% endif %}</p>
                    </div>
                </article>
                {% endfor %}
            </div>
        </div>
    </section>
    {% endif %}

    {% if press.publications.length %}
    <section class="ps-section" id="veroeffentlichungen">
        <div class="ps-section-inner">
            <header class="ps-head">
                <h2 class="ps-headline">{{ ui.publicationsHeading }}</h2>
                <p class="ps-sub">{{ ui.publicationsSub }}</p>
            </header>
            <div class="ps-list">
                {% for p in press.publications %}
                <article class="ps-item">
                    <time class="ps-item-date" datetime="{{ p.date }}">{{ p.dateLabel[locale] }}</time>
                    <div>
                        <p class="ps-item-outlet">{{ press.types[p.type][locale] }}</p>
                        <h3 class="ps-item-title"><a href="{{ p.url }}" target="_blank" rel="noopener"{% if p.lang and p.lang != locale %} hreflang="{{ p.lang }}"{% endif %}>{{ p.title }}</a></h3>
                        <p class="ps-item-meta">{% if p.author %}{{ ui.by }} {{ p.author }}{% endif %}{% if p.note %}<span class="ps-dot" aria-hidden="true">·</span>{{ p.note[locale] }}{% endif %}</p>
                    </div>
                </article>
                {% endfor %}
            </div>
        </div>
    </section>
    {% endif %}

    <section class="ps-section" id="unternehmen">
        <div class="ps-section-inner">
            <header class="ps-head">
                <h2 class="ps-headline">{{ ui.profileHeading }}</h2>
                <p class="ps-sub">{{ ui.profileSub }}</p>
            </header>
            <div class="ps-profile">
                <div>
                    <div class="ps-boiler">
                        <p class="ps-block-label">{{ ui.boilerLong }}</p>
                        <p id="ps-boiler-long" data-no-crosslink>{{ press.boilerplate[locale].long }}</p>
                        <button type="button" class="ps-copy" data-copy="ps-boiler-long" data-copied="{{ ui.copied }}">{{ ui.copy }}</button>
                    </div>
                    <div class="ps-boiler">
                        <p class="ps-block-label">{{ ui.boilerShort }}</p>
                        <p id="ps-boiler-short" data-no-crosslink>{{ press.boilerplate[locale].short }}</p>
                        <button type="button" class="ps-copy" data-copy="ps-boiler-short" data-copied="{{ ui.copied }}">{{ ui.copy }}</button>
                    </div>
                </div>
                <div>
                    <p class="ps-block-label">{{ ui.factsHeading }}</p>
                    <dl class="ps-facts" data-no-crosslink>
                        {% for f in press.facts %}
                        <dt>{{ f.label[locale] }}</dt>
                        <dd>{{ f.value[locale] }}</dd>
                        {% endfor %}
                    </dl>
                </div>
            </div>
        </div>
    </section>

    <section class="ps-section" id="presse-kit">
        <div class="ps-section-inner">
            <header class="ps-head">
                <h2 class="ps-headline">{{ ui.kitHeading }}</h2>
                <p class="ps-sub">{{ ui.kitSub }}</p>
            </header>
            <div class="ps-kit">
                {% for k in press.kit %}
                <div class="ps-kit-item">
                    <div class="ps-kit-preview ps-kit-preview--{{ k.preview }}" aria-hidden="true">
                        {% if k.preview == 'photo' %}
                        <picture>{% if k.webp %}<source type="image/webp" srcset="{{ k.webp }}">{% endif %}<img src="{{ k.file }}" alt="" loading="lazy" decoding="async"></picture>
                        {% elif k.preview == 'doc' %}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h6"/></svg>
                        {% else %}
                        <img src="{{ k.file }}" alt="" loading="lazy" decoding="async">
                        {% endif %}
                    </div>
                    <div>
                        <p class="ps-kit-label">{{ k.label[locale] }}</p>
                        <p class="ps-kit-meta">{{ k.format }}</p>
                    </div>
                    <a class="ps-link" href="{{ k.file }}" download>{{ ui.download }}</a>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="ps-section" id="gespraechspartner">
        <div class="ps-section-inner">
            <header class="ps-head">
                <h2 class="ps-headline">{{ ui.speakersHeading }}</h2>
                <p class="ps-sub">{{ ui.speakersSub }}</p>
            </header>
            <div class="ps-speakers">
                <div class="ps-speakers-photo">
                    <picture>
                        <source type="image/webp" srcset="/founders-group.webp">
                        <img src="/founders-group.jpg" alt="{{ ui.speakersPhotoAlt }}" width="800" height="800" loading="lazy" decoding="async">
                    </picture>
                </div>
                <div>
                    {% for s in press.speakers %}
                    <div class="ps-speaker">
                        <p class="ps-speaker-name"><a href="{{ pageUrls.about }}#{{ s.id }}" style="color:inherit;text-decoration:none;">{{ s.name }}</a></p>
                        <p class="ps-speaker-role">{{ s.role[locale] }}</p>
                    </div>
                    {% endfor %}
                    <a class="ps-link" href="mailto:{{ press.contact.email }}">{{ ui.speakersMail }}</a>
                </div>
            </div>
        </div>
    </section>

    <section class="ps-close">
        <h2 class="ps-close-headline">{{ ui.closeHeadline }}</h2>
        <p class="ps-close-sub">{{ ui.closeSub }}</p>
        <a class="ps-close-btn" href="mailto:{{ press.contact.email }}">
            {{ ui.closeCta }}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
    </section>

</main>

<script>
(function () {
    var buttons = document.querySelectorAll('.ps-copy[data-copy]');
    if (!buttons.length || !navigator.clipboard) return;
    buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
            var src = document.getElementById(btn.getAttribute('data-copy'));
            if (!src) return;
            var label = btn.textContent;
            navigator.clipboard.writeText(src.textContent.trim()).then(function () {
                btn.textContent = btn.getAttribute('data-copied');
                btn.classList.add('is-copied');
                setTimeout(function () { btn.textContent = label; btn.classList.remove('is-copied'); }, 1600);
            });
        });
    });
})();
</script>
