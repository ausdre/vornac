{# Helper macro to render a phase chip from its key #}
{% macro phaseChip(key, cls) %}
  <span class="{{ cls or 'rs-phase-chip' }}">{{ research.phases[key][locale] }}</span>
{% endmacro %}

<section class="rs-hero">
    <div class="rs-hero-inner">
        <h1 class="rs-hero-headline">{{ s.headlineMain }}<span class="rs-period">.</span></h1>
        <p class="rs-hero-subline">{{ s.subline }}</p>

        <p class="rs-hero-glossary">
            {{ s.glossaryLine }}
            <a href="{{ pageUrls.glossary }}" class="rs-hero-glossary-link">{{ s.glossaryLink }}
                <svg width="11" height="11" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M1 7H13M13 7L8 2M13 7L8 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </a>
        </p>

        <div class="rs-hero-stats">
            <div>
                <div class="rs-stat-num">{{ research.stats.total }}</div>
                <div class="rs-stat-label">{{ s.statTotal }}</div>
            </div>
            <div>
                <div class="rs-stat-num">{{ research.stats.tierOne }}</div>
                <div class="rs-stat-label">{{ s.statTierOne }}</div>
            </div>
            <div>
                <div class="rs-stat-num">{{ research.stats.domainCount }}</div>
                <div class="rs-stat-label">{{ s.statDomain }}</div>
            </div>
            <div>
                <div class="rs-stat-num">{{ research.stats.phaseCount }}</div>
                <div class="rs-stat-label">{{ s.statPhase }}</div>
            </div>
        </div>
    </div>
</section>

<nav class="rs-filter" aria-label="{{ s.filterLabel }}">
    <div class="rs-filter-inner">
        <div class="rs-tier-toggles" role="tablist" aria-label="{{ s.filterLabel }}">
            <button type="button" class="rs-tier-toggle is-active" data-tier="all">{{ s.tierAll }}</button>
            <button type="button" class="rs-tier-toggle" data-tier="1">{{ s.tierOne }}</button>
            <button type="button" class="rs-tier-toggle" data-tier="2">{{ s.tierTwo }}</button>
            <button type="button" class="rs-tier-toggle" data-tier="3">{{ s.tierThree }}</button>
        </div>

        <div class="rs-domain-jump" aria-label="{{ s.jumpLabel }}">
            <span class="rs-filter-label">{{ s.jumpLabel }}:</span>
            {% for d in research.domains %}
                <a href="#domain-{{ d.id }}">{{ d.number }}</a>
            {% endfor %}
        </div>
    </div>
</nav>

{% for d in research.domains %}
{% set domainHref = ("/en/research/" + d.id + "/") if locale == "en" else ("/research/" + d.id + "/") %}
{% set noteBase = domainHref %}
<section class="rs-domain" id="domain-{{ d.id }}">
    <div class="rs-domain-inner">
        <header class="rs-domain-head">
            <div class="rs-domain-num">{{ d.number }}</div>
            <div class="rs-domain-titleblock">
                <h2 class="rs-domain-title">
                    <a class="rs-domain-titlelink" href="{{ domainHref }}">
                        {{ d.title[locale] }}
                        <span class="rs-domain-arrow" aria-hidden="true">→</span>
                    </a>
                </h2>
                <p class="rs-domain-blurb">{{ d.blurb[locale] }}</p>
            </div>
            <div class="rs-domain-count">
                <strong>{{ d.count }}</strong>
                {{ s.notesInDomain }}
            </div>
        </header>

        {# ── Featured (Tier 1) ────────────────────────────── #}
        {% if d.featured.length > 0 %}
        <div class="rs-sub-block" data-sub="featured">
            <p class="rs-sub-label">{{ s.subFeatured }}</p>
            <div class="rs-featured">
                {% for n in d.featured %}
                <article class="rs-note-featured" data-tier="1" data-note="{{ n.id }}">
                    <div class="rs-note-meta">
                        <span class="rs-tier-badge">{{ s.tierOne }}</span>
                        <div class="rs-note-meta-line">
                            {% if n.phases.length > 0 %}
                                {{ n.phases.length }} {{ s.phasesShort }}
                            {% else %}
                                {{ s.noPhases }}
                            {% endif %}
                        </div>
                    </div>
                    <div class="rs-note-body">
                        <h3 class="rs-note-title">
                            <a class="rs-note-title-link" href="{{ noteBase }}{{ n.id }}/">
                                {{ n.title[locale] }}
                                <span class="rs-note-link-arrow" aria-hidden="true">→</span>
                            </a>
                        </h3>
                        <p class="rs-note-blurb">{{ n.blurb[locale] }}</p>
                        {% if n.phases.length > 0 %}
                        <div class="rs-phase-chips">
                            {% for p in n.phases %}{{ phaseChip(p) }}{% endfor %}
                        </div>
                        {% endif %}
                    </div>
                </article>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        {# ── Reference (Tier 2) ───────────────────────────── #}
        {% if d.reference.length > 0 %}
        <div class="rs-sub-block" data-sub="reference">
            <p class="rs-sub-label">{{ s.subReference }}</p>
            <div class="rs-reference">
                {% for n in d.reference %}
                <article class="rs-note-ref" data-tier="2" data-note="{{ n.id }}">
                    <div class="rs-ref-meta">{{ s.tierTwo }}</div>
                    <h3 class="rs-ref-title">
                        <a class="rs-ref-title-link" href="{{ noteBase }}{{ n.id }}/">
                            {{ n.title[locale] }}
                            <span class="rs-note-link-arrow" aria-hidden="true">→</span>
                        </a>
                    </h3>
                    <p class="rs-ref-blurb">{{ n.blurb[locale] }}</p>
                    {% if n.phases.length > 0 %}
                    <div class="rs-ref-phases">
                        {% for p in n.phases %}<span class="rs-ref-phase">{{ research.phases[p][locale] }}</span>{% endfor %}
                    </div>
                    {% endif %}
                </article>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        {# ── Background (Tier 3) ──────────────────────────── #}
        {% if d.background.length > 0 %}
        <div class="rs-sub-block" data-sub="background">
            <p class="rs-sub-label">{{ s.subBackground }}</p>
            <ul class="rs-bg-list">
                {% for n in d.background %}
                <li class="rs-bg-item" data-tier="3" data-note="{{ n.id }}">
                    <div class="rs-bg-title">
                        <a class="rs-bg-title-link" href="{{ noteBase }}{{ n.id }}/">
                            {{ n.title[locale] }}
                            <span class="rs-note-link-arrow" aria-hidden="true">→</span>
                        </a>
                    </div>
                    <p class="rs-bg-blurb">{{ n.blurb[locale] }}</p>
                    <div class="rs-bg-phases">
                        {% if n.phases.length > 0 %}
                            {% for p in n.phases %}{{ research.phases[p][locale] }}{% if not loop.last %} · {% endif %}{% endfor %}
                        {% else %}
                            &mdash;
                        {% endif %}
                    </div>
                </li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}
    </div>
</section>
{% endfor %}

<section class="rs-method">
    <div class="rs-method-inner">
        <div>
            <p class="rs-method-eyebrow">{{ s.methodEyebrow }}</p>
            <h2 class="rs-method-headline">{{ s.methodHeadline }}</h2>
        </div>
        <div>
            <div class="rs-method-body">
                <p>{{ s.methodIntro1 }}</p>
                <p>{{ s.methodIntro2 }}</p>
            </div>
            <ul class="rs-method-list">
                <li><span><strong>{{ s.methodLi1Title }}</strong> {{ s.methodLi1 }}</span></li>
                <li><span><strong>{{ s.methodLi2Title }}</strong> {{ s.methodLi2 }}</span></li>
                <li><span><strong>{{ s.methodLi3Title }}</strong> {{ s.methodLi3 }}</span></li>
                <li><span><strong>{{ s.methodLi4Title }}</strong> {{ s.methodLi4 }}</span></li>
            </ul>
            <p class="rs-method-glossary">
                {{ s.glossaryLine }}
                <a href="{{ pageUrls.glossary }}">{{ s.glossaryLink }}
                    <svg width="11" height="11" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M1 7H13M13 7L8 2M13 7L8 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </a>
            </p>
        </div>
    </div>
</section>

<section class="rs-cta">
    <div class="rs-cta-inner">
        <div>
            <p class="rs-cta-eyebrow">{{ s.ctaEyebrow }}</p>
            <h2 class="rs-cta-headline">{{ s.ctaHeadline }}</h2>
        </div>
        {% include "partials/hero-demo-button.njk" %}
    </div>
</section>

{# Lightweight tier filter — toggles visibility of cards by data-tier.
   No framework, no dependencies; fails closed on no-JS by showing everything. #}
<script>
(function () {
    const toggles = document.querySelectorAll('.rs-tier-toggle');
    const allItems = document.querySelectorAll('[data-tier]');
    const subBlocks = document.querySelectorAll('.rs-sub-block');

    function apply(tier) {
        allItems.forEach((el) => {
            const match = tier === 'all' || el.getAttribute('data-tier') === tier;
            el.toggleAttribute('data-tier-hidden', !match);
        });
        subBlocks.forEach((block) => {
            const visible = block.querySelectorAll('[data-tier]:not([data-tier-hidden])');
            block.toggleAttribute('data-empty', visible.length === 0);
        });
    }

    toggles.forEach((btn) => {
        btn.addEventListener('click', () => {
            toggles.forEach((b) => b.classList.remove('is-active'));
            btn.classList.add('is-active');
            apply(btn.getAttribute('data-tier'));
        });
    });
})();
</script>
