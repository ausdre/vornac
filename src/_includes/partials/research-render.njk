    "headlineMain":   "The Research Index",
    "subline":        "Reference notes on offensive security: methodologies, tooling, and per-service exploitation matrices. Hand-titled, cross-mapped to engagement phases, kept free of dated artifacts.",
    "statTotal":      "Notes",
    "statTierOne":    "Featured",
    "statDomain":     "Domains",
    "statPhase":      "Engagement phases",
    "filterLabel":    "Filter",
    "tierAll":        "All",
    "tierOne":        "Featured",
    "tierTwo":        "Reference",
    "tierThree":      "Background",
    "jumpLabel":      "Jump to",
    "notesInDomain":  "notes",
    "subFeatured":    "Featured",
    "subReference":   "Reference",
    "subBackground":  "Background",
    "methodEyebrow":  "Methodology",
    "methodHeadline": "How the index is curated",
    "methodIntro1":   "Every entry is fingerprinted by SHA-256 against the source corpus, deduplicated, machine-extracted from diagrammatic form, and manually re-titled in neutral English. Where a topic has aged out (dated tooling, year-stamped surveys), it is removed rather than rebranded.",
    "methodIntro2":   "Entries are mapped to the engagement phase they support, so a tester reading a finding in our report can land on the exact reference that informed it.",
    "methodLi1Title": "Stable identifiers.",
    "methodLi1":      "Every note carries a content hash. Updates change the hash; the index is reproducible.",
    "methodLi2Title": "One language.",
    "methodLi2":      "Published in English. Titles and blurbs are neutral so they remain quotable.",
    "methodLi3Title": "Phase-mapped.",
    "methodLi3":      "Each note links to the engagement phases where it actually applies, not where it might.",
    "methodLi4Title": "No advertising.",
    "methodLi4":      "The index does not promote tools or vendors. Where a tool is named, it is named for technical specificity.",
    "phasesShort":    "phases",
    "noPhases":       "no specific phase",
    "glossaryLine":   "Looking up an acronym?",
    "glossaryLink":   "Open the Glossary",
    "ctaEyebrow":     "From reference to evidence",
    "ctaHeadline":    "Validate these gaps in your own environment.",
    "ctaButton":      "Book a demo"
} %}
{% else %}
{% set s = {
    "eyebrow":        "VORNAC RESEARCH · KURATIERTER REFERENZ-INDEX",
    "headlineMain":   "Der Research Index",
    "subline":        "Referenznotizen zur Offensive Security: Methodiken, Tooling und Exploitation-Matrizen pro Dienst. Handgetitelt, zu Engagement-Phasen quervernetzt, frei von veralteten Artefakten.",
    "statTotal":      "Notizen",
    "statTierOne":    "Featured",
    "statDomain":     "Domains",
    "statPhase":      "Engagement-Phasen",
    "filterLabel":    "Filter",
    "tierAll":        "Alle",
    "tierOne":        "Featured",
    "tierTwo":        "Referenz",
    "tierThree":      "Background",
    "jumpLabel":      "Springen zu",
    "notesInDomain":  "Notizen",
    "subFeatured":    "Featured",
    "subReference":   "Referenz",
    "subBackground":  "Background",
    "methodEyebrow":  "Methodik",
    "methodHeadline": "Wie der Index kuratiert wird",
    "methodIntro1":   "Jeder Eintrag wird per SHA-256 gegen den Quell-Korpus gefingerprintet, dedupliziert, maschinell aus diagrammatischer Form extrahiert und manuell in neutralem Englisch neu betitelt. Veraltete Themen (altes Tooling, jahresgestempelte Umfragen) werden entfernt statt umgelabelt.",
    "methodIntro2":   "Einträge werden auf die Engagement-Phase abgebildet, die sie unterstützen, damit ein Tester, der in unserem Report einen Befund liest, exakt auf die Referenz kommt, die ihn informiert hat.",
    "methodLi1Title": "Stabile Identifier.",
    "methodLi1":      "Jede Notiz trägt einen Content-Hash. Updates ändern den Hash; der Index ist reproduzierbar.",
    "methodLi2Title": "Eine Sprache.",
    "methodLi2":      "Veröffentlicht auf Englisch. Titel und Kurztexte bleiben neutral und damit zitierbar.",
    "methodLi3Title": "Phasen-gemappt.",
    "methodLi3":      "Jede Notiz verweist auf die Engagement-Phasen, in denen sie tatsächlich greift, nicht in denen sie könnte.",
    "methodLi4Title": "Keine Werbung.",
    "methodLi4":      "Der Index bewirbt weder Tools noch Anbieter. Wo ein Tool genannt wird, dann aus technischer Genauigkeit.",
    "phasesShort":    "Phasen",
    "noPhases":       "keine spezifische Phase",
    "glossaryLine":   "Akronym nachschlagen?",
    "glossaryLink":   "Zum Glossar",
    "ctaEyebrow":     "Von der Referenz zum Befund",
