{#
  SalesViewer — B2B visitor / company identification tracking.

  Loaded in <head>, directly after lang-redirect.njk. It has to run before the
  language redirect navigates away, otherwise the entry hit on / (the one that
  still carries the external referrer) gets aborted for German-locale first-time
  visitors. When a redirect is in flight we skip entirely, so the counterpart
  page fires the single hit instead.
#}
<script>
    if (!window.__vornacLangRedirect) (function(w,d,s,l,i){
        var g=w[l] ? '&s='+w[l]:'', f=d.getElementsByTagName(s)[0], j=d.createElement(s);
        j.async=true,j.src='https://slsnlytcs.com/stm.js?id='+i+g;
        j.referrerPolicy='no-referrer-when-downgrade';
        f.parentNode.insertBefore(j,f);
    })(window,document,'script','name','T0n2R5f6z6y5')
</script>
