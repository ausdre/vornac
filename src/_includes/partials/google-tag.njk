{#
  Google tag (gtag.js) — Google Ads account AW-18358463564 plus the GA4
  property G-9LJGWDQ2CR that the form scripts send their events to.

  Loaded in <head> after lang-redirect.njk / leadfeeder.njk. `gtag` is always
  defined (the form scripts call it for conversion events), but the initial
  `config` page_views are skipped while a language redirect is in flight — same
  reasoning as leadfeeder.njk: the counterpart page fires the single hit.

  Conversion events (e.g. "Termin vereinbaren",
  AW-18358463564/E8DRCLW1xtkcEMzY_7FE) fire from hero-demo-script.njk on
  successful form submission.

  Consent Mode v2 (TTDSG §25 / GDPR): the default-deny call is the first
  dataLayer entry — before the gtag.js loader and outside the lang-redirect
  guard — so Google sets no _gcl_*/_ga* cookies without consent.
  consent-banner.njk collects the choice and stores it under
  'vornac_consent_v1' in localStorage; a stored "granted" is re-applied here
  on every pageview, before the config calls. Leadfeeder and Plausible are
  deliberately not consent-gated (legitimate interest / cookieless).

  Google Tag Manager ({{ site.analytics.gtmContainerId }}) loads between the
  consent defaults and the gtag.js loader: after the defaults because GTM
  reads the consent state that is current when it boots, behind the
  lang-redirect guard because a redirecting page must not fire container
  tags (the counterpart page is the one countable pageview). The matching
  <noscript> iframe lives in layouts/base.njk right after <body>.
#}
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'denied'
  });
  // With ad_storage denied there is no _gcl_* cookie, so a gclid would die on
  // the first internal navigation. url_passthrough carries it (plus dclid,
  // wbraid, gbraid) through internal links as a URL param instead;
  // ads_data_redaction additionally strips ad-click identifiers from the
  // cookieless pings Google still receives while consent is denied.
  gtag('set', 'url_passthrough', true);
  gtag('set', 'ads_data_redaction', true);
  try {
    if (localStorage.getItem('vornac_consent_v1') === 'granted') {
      gtag('consent', 'update', {
        ad_storage: 'granted',
        ad_user_data: 'granted',
        ad_personalization: 'granted',
        analytics_storage: 'granted'
      });
    }
  } catch (e) {}
</script>
<script>
  if (!window.__vornacLangRedirect) {
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','{{ site.analytics.gtmContainerId }}');
  }
</script>
<script async src="https://www.googletagmanager.com/gtag/js?id=AW-18358463564"></script>
<script>
  if (!window.__vornacLangRedirect) {
    // If lang-redirect.njk just replaced the entry URL, the original external
    // referrer (Google organic, LinkedIn, …) was stashed in sessionStorage —
    // hand it to GA4/Ads as page_referrer so the visit isn't counted as Direct.
    var configParams = {};
    try {
      var storedReferrer = sessionStorage.getItem('vornac_page_referrer');
      if (storedReferrer) {
        configParams.page_referrer = storedReferrer;
        sessionStorage.removeItem('vornac_page_referrer');
      }
    } catch (e) {}
    gtag('js', new Date());
    gtag('config', 'AW-18358463564', configParams);
    gtag('config', 'G-9LJGWDQ2CR', configParams);
  }

  // The header "Validate Now" pill and the FAQ CTA link straight to the
  // zeeg.me scheduler — the direct booking path. Beacon transport so the
  // event survives the same-tab navigation of the header CTA.
  document.addEventListener('click', function (e) {
    var link = e.target.closest ? e.target.closest('a[href*="zeeg.me"]') : null;
    if (!link) return;
    gtag('event', 'scheduler_click', {
      send_to: 'G-9LJGWDQ2CR',
      link_url: link.href,
      transport_type: 'beacon'
    });
  });
</script>
