{% block content %}
<section class="v-hero">
    <div class="v-hero-inner">
        <p class="v-hero-kicker v-reveal">Continuous adversarial validation</p>
        <h1 class="v-hero-headline v-reveal" data-reveal-delay="1">
            Continuous validation.<br>
            <span class="v-amber-mark">Proven exploitability.</span><br>
            Audit-ready by design.
        </h1>
        <p class="v-hero-subline v-reveal" data-reveal-delay="2">
            VORNAC runs the techniques an attacker would — on your live production environment, continuously, on schedule, via API. Every finding is exploitability-proven. Every report is audit-ready for NIS2, DORA, BaFin VAIT/BAIT, KRITIS, and TISAX.
        </p>
        <div class="v-hero-actions v-reveal" data-reveal-delay="3">
            <a href="{{ site.contact.bookDemo }}" target="_blank" rel="noopener" class="v-btn-primary">
                Book a demo
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                </svg>
            </a>
            <a href="{{ pageUrls.pentesting }}" class="v-btn-ghost">See the platform overview</a>
        </div>
    </div>
</section>

