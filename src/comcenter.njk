---
title: "VORNAC · Command Center"
description: "VORNAC Command Center: authorized testing workspace, scope controls, and operational visibility for continuous security programs."
i18nKey: comcenter
ogType: website
bodyClass: comcenter
---
{% extends "layouts/base.njk" %}

{# Comcenter is a demo dashboard — suppress the marketing announcement bar
   and main nav, and use its own slim header instead. #}
{% block announcementBar %}{% endblock %}
{% block siteHeader %}
<header id="site-header" class="relative sticky top-0 z-40 border-b border-stone-300 backdrop-blur" style="background-color: rgba(245, 242, 237, 0.97);">
    <nav class="mx-auto flex max-w-[1440px] items-center justify-between px-6 py-4">
        <a href="{{ pageUrls.index }}#top" class="flex items-center gap-3" aria-label="{{ t.a11y.siteHome }}">
            <img src="{{ site.logos.blackSvg }}" class="nav-logo h-10 w-auto" alt="{{ site.brand }}"/>
        </a>
        <div class="flex items-center gap-6 text-xs">
            <span class="hidden lg:inline font-mono tracking-[0.22em] text-stone-500">
                C2 COMMAND CENTER
            </span>
            <a href="{{ pageUrls.index }}#contact"
               class="rounded-lg bg-amber-500 px-4 py-2 text-xs font-semibold text-white shadow-soft hover:bg-amber-600 hover-lift">
                Get support
            </a>
        </div>
    </nav>
</header>
{% endblock %}

{% block content %}
<section class="border-b border-stone-600 bg-stone-800 backdrop-blur">
    <div class="mx-auto flex max-w-[1440px] items-center justify-between gap-6 px-6 py-3">
        <div class="flex items-center gap-3">
            <span class="h-2 w-2 animate-pulse rounded-full bg-amber-500 shadow-[0_0_10px_rgba(245,158,11,0.8)]"></span>
            <div class="font-mono text-[11px] uppercase tracking-[0.22em] text-stone-300">
                ACTIVE AUTONOMOUS PENTEST SESSION
            </div>
        </div>
        <div class="flex items-center gap-6 font-mono text-[11px] text-stone-300">
            <div>ORG: <span class="text-white">VORNAC DEMO</span></div>
            <div>MODE: <span class="text-amber-500">CONTINUOUS</span></div>
            <div>LAST RUN: <span class="text-white">23m ago</span></div>
        </div>
    </div>
</section>

<main class="min-h-screen bg-warm">
    <div class="mx-auto max-w-[1440px] px-6 py-6">
        <div class="vornac-dashboard">

            <aside class="flex h-[calc(100vh-120px)] min-w-[260px] max-w-[260px] flex-col rounded-2xl border border-stone-600 bg-stone-800 p-4">
                <div class="mb-4 font-mono text-[10px] uppercase tracking-[0.16em] text-stone-400">Views</div>
                <button data-view-target="overview" class="view-btn mb-1 w-full rounded-lg bg-stone-700 px-3 py-2 text-left text-[12px] text-white">Overview</button>
                <button data-view-target="live" class="view-btn mb-1 w-full rounded-lg px-3 py-2 text-left text-[12px] text-stone-400 hover:bg-stone-700">Live session</button>
                <button data-view-target="queue" class="view-btn mb-1 w-full rounded-lg px-3 py-2 text-left text-[12px] text-stone-400 hover:bg-stone-700">Queue</button>
                <button data-view-target="history" class="view-btn mb-1 w-full rounded-lg px-3 py-2 text-left text-[12px] text-stone-400 hover:bg-stone-700">History</button>
                <button data-view-target="reports" class="view-btn mb-1 w-full rounded-lg px-3 py-2 text-left text-[12px] text-stone-400 hover:bg-stone-700">Reports</button>
                <button data-view-target="settings" class="view-btn mb-1 w-full rounded-lg px-3 py-2 text-left text-[12px] text-stone-400 hover:bg-stone-700">Settings</button>
                <button data-view-target="demo" class="view-btn mt-3 w-full rounded-lg border border-amber-500/40 bg-amber-500/10 px-3 py-2 text-left text-[12px] text-amber-500 hover:bg-amber-500 hover:text-stone-900">Demo telemetry</button>
            </aside>

            <section id="views" class="ml-4 flex-1 space-y-6">

                <section data-view="overview" class="space-y-4">
                    <article class="flex items-start justify-between gap-6 rounded-xl border border-red-500/40 bg-red-900/30 px-6 py-4">
                        <div>
                            <div class="font-mono text-[11px] uppercase tracking-[0.18em] text-red-300">
                                STOP! READ BEFORE PROCEEDING
                            </div>
                            <h1 class="mt-1 text-lg uppercase font-semibold">VORNAC IS A CONTROLLED CYBER OPERATIONS CAPABILITY</h1>
                            <p class="mt-2 max-w-3xl text-[12px] text-red-100/90">
                                USE IS AUTHORIZED ONLY AGAINST INFRASTRUCTURE, APPLICATIONS, AND DATA YOU OWN OR WHERE YOU HOLD EXPLICIT WRITTEN PERMISSION TO TEST. ANY ACTION AGAINST THIRD-PARTY SYSTEMS WITHOUT WRITTEN AUTHORIZATION IS ILLEGAL. YOU ARE FULLY AND PERSONALLY LIABLE FOR EVERYTHING INITIATED THROUGH VORNAC, INCLUDING AUTOMATED AGENTS, INTEGRATIONS, SCHEDULED TASKS, AND API CALLS. THIS PLATFORM IS MONITORED; ACTIVITY IS LOGGED, ATTRIBUTABLE, AND MAY BE RETAINED OR DISCLOSED WHERE REQUIRED. OPERATE STRICTLY WITHIN THE APPROVED SCOPE, TIME WINDOW, AND RULES OF ENGAGEMENT, AND ABORT IMMEDIATELY IF BEHAVIOR DEVIATES FROM PLAN. BY CONTINUING, YOU CONFIRM YOU HAVE WRITTEN AUTHORIZATION FOR ALL TARGETS AND ACCEPT FULL LEGAL RESPONSIBILITY FOR ALL OUTCOMES.
                            </p>
                        </div>
                    </article>

                    <div class="grid grid-cols-3 gap-4">
                        <article class="rounded-xl border border-stone-600 bg-stone-900 px-4 py-3">
                            <div class="font-mono text-[10px] uppercase tracking-[0.16em] text-stone-400">Queue</div>
                            <div class="mt-2 text-2xl font-semibold text-white">4</div>
                            <div class="text-[11px] text-stone-400">pending pentest campaigns</div>
                        </article>
                        <article class="rounded-xl border border-stone-600 bg-stone-900 px-4 py-3">
                            <div class="font-mono text-[10px] uppercase tracking-[0.16em] text-stone-400">Pentests completed</div>
                            <div class="mt-2 text-2xl font-semibold text-amber-500">27</div>
                            <div class="text-[11px] text-stone-400">last 30 days</div>
                        </article>
                        <article class="rounded-xl border border-stone-600 bg-stone-900 px-4 py-3">
                            <div class="font-mono text-[10px] uppercase tracking-[0.16em] text-stone-400">Live status</div>
                            <div class="mt-2 flex items-center gap-2 text-[13px] font-semibold text-emerald-400">
                                <span class="h-2 w-2 animate-pulse rounded-full bg-emerald-400 shadow-[0_0_10px_rgba(52,211,153,0.9)]"></span>
                                <span>ACTIVE PENTEST RUNNING</span>
                            </div>
                            <div class="mt-1 text-[11px] text-stone-400">AUTH-SERVER-04 · external perimeter · ETA 04:12</div>
                        </article>
                    </div>
                </section>

                <section data-view="live" class="hidden space-y-4">
                    <div class="flex items-center justify-between">
                        <h2 class="font-mono text-[11px] uppercase tracking-[0.14em] text-stone-400">Live pentest session</h2>
                    </div>
                    <div class="grid grid-cols-[1.4fr_1fr] gap-4">
                        <article class="rounded-xl border border-stone-600 bg-stone-900 p-4">
                            <header class="mb-3 flex items-center justify-between font-mono text-[11px] uppercase tracking-[0.14em] text-stone-400">
                                <span>Current campaign</span>
                                <span class="rounded-full bg-emerald-500/10 px-2 py-0.5 text-[10px] text-emerald-400">running</span>
                            </header>
                            <div class="space-y-2 text-[12px] text-white">
                                <div class="flex items-center justify-between"><span class="text-stone-400">Name</span><span class="font-mono">External perimeter scan</span></div>
                                <div class="flex items-center justify-between"><span class="text-stone-400">Target</span><span class="font-mono">AUTH-SERVER-04 (eu-west)</span></div>
                                <div class="flex items-center justify-between"><span class="text-stone-400">Mode</span><span class="font-mono text-amber-500">Autonomous · non-destructive</span></div>
                                <div class="flex items-center justify-between"><span class="text-stone-400">Progress</span><span class="font-mono">52% · ETA 04:12</span></div>
                            </div>
                            <div class="mt-4 h-2 w-full rounded-full bg-stone-700"><div class="h-2 w-1/2 rounded-full bg-emerald-400"></div></div>
                        </article>
                        <article class="rounded-xl border border-stone-600 bg-stone-900 p-4">
                            <header class="mb-3 font-mono text-[11px] uppercase tracking-[0.14em] text-stone-400">Safety guardrails</header>
                            <ul class="space-y-1 text-[11px] text-stone-400">
                                <li>• Non-destructive mode enforced for this session.</li>
                                <li>• Out-of-scope domains hard-blocked by policy.</li>
                                <li>• All actions are logged and time-stamped.</li>
                            </ul>
                        </article>
                    </div>
                </section>

                <section data-view="queue" class="hidden space-y-4">
                    <div class="flex items-center justify-between">
                        <h2 class="font-mono text-[11px] uppercase tracking-[0.14em] text-stone-400">Queue</h2>
                        <button id="open-operation-modal" class="rounded-lg bg-amber-500 px-4 py-2 text-[11px] font-mono font-semibold text-white hover:bg-amber-600">New operation</button>
                    </div>
                    <div class="h-[420px] rounded-xl border border-stone-600 bg-stone-900 p-4">
                        <div class="mb-3 flex items-center justify-between text-[11px] font-mono text-stone-400">
                            <div class="flex gap-3">
                                <button class="rounded-full bg-stone-700 px-3 py-1 text-xs text-white">All</button>
                                <button class="rounded-full px-3 py-1 text-xs hover:bg-stone-700">Queued</button>
                                <button class="rounded-full px-3 py-1 text-xs hover:bg-stone-700">Running</button>
                                <button class="rounded-full px-3 py-1 text-xs hover:bg-stone-700">Paused</button>
                            </div>
                        </div>
                        <div class="h-[340px] overflow-y-auto overflow-x-hidden">
                            <table class="min-w-full border-collapse text-left text-[11px] font-mono text-white">
                                <thead class="border-b border-stone-600 text-stone-400">
                                    <tr><th class="py-2 pr-4">Name</th><th class="py-2 pr-4">Target</th><th class="py-2 pr-4">Mode</th><th class="py-2 pr-4">Status</th><th class="py-2 pr-4">Scheduled</th></tr>
                                </thead>
                                <tbody class="divide-y divide-stone-700">
                                    <tr><td class="py-2 pr-4">External perimeter scan</td><td class="py-2 pr-4">*.example.com</td><td class="py-2 pr-4 text-amber-500">Autonomous</td><td class="py-2 pr-4 text-emerald-400">Running</td><td class="py-2 pr-4">now</td></tr>
                                    <tr><td class="py-2 pr-4">API abuse simulation</td><td class="py-2 pr-4">api.example.com</td><td class="py-2 pr-4">Red team</td><td class="py-2 pr-4 text-slate-300">Queued</td><td class="py-2 pr-4">tonight 02:00</td></tr>
                                    <tr><td class="py-2 pr-4">Internal lateral movement</td><td class="py-2 pr-4">10.0.0.0/16</td><td class="py-2 pr-4">APT simulation</td><td class="py-2 pr-4 text-slate-300">Queued</td><td class="py-2 pr-4">after exterior complete</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <section data-view="history" class="hidden space-y-4">
                    <h2 class="font-mono text-[11px] uppercase tracking-[0.14em] text-stone-400">History</h2>
                    <div class="h-[460px] rounded-xl border border-stone-600 bg-stone-900 p-4">
                        <div class="h-full overflow-y-auto overflow-x-hidden">
                            <table class="min-w-full border-collapse text-left text-[11px] font-mono text-white">
                                <thead class="border-b border-stone-600 text-stone-400">
                                    <tr><th class="py-2 pr-4">Name</th><th class="py-2 pr-4">Scope</th><th class="py-2 pr-4">Finished</th><th class="py-2 pr-4">Findings</th><th class="py-2 pr-4">Status</th></tr>
                                </thead>
                                <tbody class="divide-y divide-stone-700">
                                    <tr><td class="py-2 pr-4">External perimeter scan</td><td class="py-2 pr-4">internet-facing</td><td class="py-2 pr-4">2025-12-14 03:22</td><td class="py-2 pr-4">3 critical / 12 high</td><td class="py-2 pr-4 text-emerald-400">Completed</td></tr>
                                    <tr><td class="py-2 pr-4">Internal lateral movement</td><td class="py-2 pr-4">10.0.0.0/16</td><td class="py-2 pr-4">2025-12-10 01:11</td><td class="py-2 pr-4">5 high / 9 medium</td><td class="py-2 pr-4 text-emerald-400">Completed</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <section data-view="reports" class="hidden space-y-4">
                    <h2 class="font-mono text-[11px] uppercase tracking-[0.14em] text-stone-400">Reports</h2>
                    <div class="grid grid-cols-3 gap-4">
                        <article class="rounded-xl border border-stone-600 bg-stone-900 px-4 py-3"><div class="text-xs text-stone-400">Latest technical report</div><div class="mt-1 text-sm font-semibold text-amber-500">External perimeter · PDF</div><div class="mt-2 text-[11px] text-stone-400">Generated 2025-12-14</div></article>
                        <article class="rounded-xl border border-stone-600 bg-stone-900 px-4 py-3"><div class="text-xs text-stone-400">Management summary</div><div class="mt-1 text-sm font-semibold text-amber-500">Executive overview</div><div class="mt-2 text-[11px] text-stone-400">Generated 2025-12-13</div></article>
                        <article class="rounded-xl border border-stone-600 bg-stone-900 px-4 py-3"><div class="text-xs text-stone-400">Compliance mapping</div><div class="mt-1 text-sm font-semibold text-amber-500">NIS2 · DORA · VAIT</div><div class="mt-2 text-[11px] text-stone-400">Ready for export</div></article>
                    </div>
                    <div class="rounded-xl border border-stone-600 bg-stone-900 p-4 text-[11px] font-mono text-stone-400">
                        <div class="mb-3 flex items-center justify-between">
                            <span>Export report (demo)</span>
                            <button class="rounded-lg border border-stone-600 px-3 py-1 text-[11px] text-stone-400 opacity-60">Export PDF (disabled)</button>
                        </div>
                        <p>In the production version, full technical reports and management summaries can be exported.</p>
                    </div>
                </section>

                <section data-view="settings" class="hidden space-y-4">
                    <h2 class="font-mono text-[11px] uppercase tracking-[0.14em] text-stone-400">Settings</h2>
                    <div class="grid grid-cols-2 gap-4">
                        <article class="rounded-xl border border-stone-600 bg-stone-900 p-4">
                            <header class="mb-3 font-mono text-[11px] uppercase tracking-[0.14em] text-stone-400">Schedules</header>
                            <ul class="space-y-1 text-[11px] text-stone-400">
                                <li>• Nightly external scan: 01:00–04:00 (enabled)</li>
                                <li>• Weekly internal campaign: Sunday 02:00 (enabled)</li>
                                <li>• Ad-hoc red team: manual approval required</li>
                            </ul>
                        </article>
                        <article class="rounded-xl border border-stone-600 bg-stone-900 p-4">
                            <header class="mb-3 font-mono text-[11px] uppercase tracking-[0.14em] text-stone-400">Scope configuration</header>
                            <ul class="space-y-1 text-[11px] text-stone-400">
                                <li>• In-scope: *.example.com, 10.0.0.0/16</li>
                                <li>• Out-of-scope: payment provider, third-party SaaS</li>
                                <li>• Safe-mode: non-destructive (default)</li>
                            </ul>
                        </article>
                    </div>
                </section>

                <section data-view="demo" class="hidden grid grid-cols-[1.2fr_1fr] gap-4">
                    <article class="flex flex-col rounded-xl border border-stone-600 bg-stone-900 p-4">
                        <header class="mb-3 flex items-center justify-between font-mono text-[11px] uppercase tracking-[0.14em] text-stone-400">
                            <span>Demo telemetry · traffic</span>
                            <span class="rounded-full bg-amber-500/10 px-2 py-0.5 text-[10px] text-amber-500">simulated</span>
                        </header>
                        <div class="relative h-[260px] w-full"><canvas id="trafficChart"></canvas></div>
                    </article>
                    <article class="flex flex-col rounded-xl border border-stone-600 bg-stone-800 p-4">
                        <header class="mb-3 flex items-center justify-between font-mono text-[11px] uppercase tracking-[0.14em] text-stone-400">
                            <span>Demo telemetry · system log</span>
                            <span class="text-[10px] text-stone-400">read-only</span>
                        </header>
                        <div id="terminal" class="h-[260px] space-y-1 overflow-y-auto font-mono text-[11px] text-slate-300"></div>
                    </article>
                </section>

            </section>
        </div>
    </div>
</main>

<div id="operation-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-stone-900/70 backdrop-blur">
    <div class="w-full max-w-md rounded-xl border border-amber-500/40 bg-stone-800 p-6">
        <h3 class="mb-4 font-mono text-[11px] uppercase tracking-[0.14em] text-amber-500">New operation (demo)</h3>
        <div class="space-y-3 text-[11px] font-mono text-stone-400">
            <div>
                <label class="mb-1 block">Target (URL/IP)</label>
                <input class="w-full rounded-lg border border-stone-600 bg-stone-900 px-3 py-2 text-[11px] text-white" placeholder="https://target-system.com"/>
            </div>
            <div>
                <label class="mb-1 block">Profile</label>
                <select class="w-full rounded-lg border border-stone-600 bg-stone-900 px-3 py-2 text-[11px] text-white">
                    <option>NIS2 compliance audit (non-destructive)</option>
                    <option>Red team assault (full scope)</option>
                    <option>APT simulation</option>
                </select>
            </div>
        </div>
        <div class="mt-5 flex gap-2">
            <button class="flex-1 rounded-lg bg-amber-500 px-3 py-2 text-[11px] font-mono font-semibold text-white opacity-60">Start (disabled in demo)</button>
            <button id="close-operation-modal" class="flex-1 rounded-lg border border-stone-600 px-3 py-2 text-[11px] font-mono text-stone-400 hover:bg-stone-700">Close</button>
        </div>
    </div>
</div>
{% endblock %}

{% block extraBodyEnd %}
{# Chart.js 4.4.0, self-hosted rather than pulled from cdn.jsdelivr.net:
   a CDN request hands the visitor's IP to a third party on page load,
   before any consent decision — the same reason the brand webfonts are
   served from our own origin (see partials/head-fonts.njk). #}
<script src="/chart.umd.js"></script>
<script>
    const viewButtons = document.querySelectorAll('.view-btn');
    const views = document.querySelectorAll('[data-view]');
    function setView(name) {
        views.forEach(v => v.classList.toggle('hidden', v.dataset.view !== name));
        viewButtons.forEach(btn => {
            const active = btn.dataset.viewTarget === name;
            btn.classList.toggle('bg-stone-700', active);
            btn.classList.toggle('text-white', active);
            if (!active) {
                btn.classList.remove('bg-stone-700', 'text-white');
            }
        });
    }
    viewButtons.forEach(btn => {
        btn.addEventListener('click', () => setView(btn.dataset.viewTarget));
    });
    setView('overview');

    const openModal = document.getElementById('open-operation-modal');
    const closeModal = document.getElementById('close-operation-modal');
    const modal = document.getElementById('operation-modal');
    if (openModal && closeModal && modal) {
        openModal.addEventListener('click', () => modal.classList.remove('hidden'));
        closeModal.addEventListener('click', () => modal.classList.add('hidden'));
    }

    const terminal = document.getElementById('terminal');
    const logs = [
        { type: 'sys', msg: 'Scanning port 443 on 192.168.4.1...' },
        { type: 'warn', msg: 'WAF detected at edge perimeter.' },
        { type: 'sys', msg: 'Rotated proxy chain (42ms RTT).' },
        { type: 'crit', msg: 'VULNERABILITY: SQL injection in /login.' },
        { type: 'sys', msg: 'Indexing directory structure for reporting.' }
    ];
    function addLog() {
        if (!terminal) return;
        const log = logs[Math.floor(Math.random() * logs.length)];
        const row = document.createElement('div');
        row.className = 'flex gap-2 text-[11px]';
        const time = new Date().toLocaleTimeString('de-DE', { hour12: false });
        const typeClass =
            log.type === 'crit' ? 'text-red-400 font-semibold' :
            log.type === 'warn' ? 'text-orange-400' :
            'text-amber-500';
        row.innerHTML =
            `<span class="text-slate-500">[${time}]</span>` +
            `<span class="${typeClass}">${log.type.toUpperCase()}</span>` +
            `<span class="text-slate-300">${log.msg}</span>`;
        terminal.appendChild(row);
        terminal.scrollTop = terminal.scrollHeight;
    }
    setInterval(addLog, 2500);

    const ctx = document.getElementById('trafficChart')?.getContext('2d');
    if (ctx) {
        const gradient = ctx.createLinearGradient(0, 0, 0, 160);
        gradient.addColorStop(0, 'rgba(255, 154, 77, 0.45)');
        gradient.addColorStop(1, 'rgba(255, 154, 77, 0)');
        const chart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: Array(30).fill(''),
                datasets: [{
                    data: Array(30).fill(0).map(() => Math.random() * 80 + 20),
                    borderColor: '#FF9A4D',
                    borderWidth: 2,
                    backgroundColor: gradient,
                    fill: true,
                    tension: 0.35,
                    pointRadius: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { display: false },
                    y: {
                        display: true,
                        border: { display: false },
                        grid: { color: 'rgba(148,163,184,0.16)' },
                        ticks: { color: '#9ca3af', font: { family: 'JetBrains Mono', size: 10 } }
                    }
                },
                animation: false
            }
        });
        setInterval(() => {
            const data = chart.data.datasets[0].data;
            data.shift();
            data.push(Math.random() * 80 + 20);
            chart.update();
        }, 1000);
    }
</script>
{% endblock %}
