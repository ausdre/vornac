<section class="pent-contact" id="contact">
    <div class="pent-contact-inner">
        <header class="pent-contact-header">
            <h2 class="pent-contact-headline">
                <span class="pent-contact-headline-emph">VORNAC</span> in Aktion sehen?
            </h2>
            <p class="pent-contact-sub">
                Live-Session mit unserem Team buchen — oder direkt schreiben. Rückmeldung innerhalb von 24 Stunden.
            </p>
            <a href="{{ site.contact.bookDemo }}" target="_blank" rel="noopener" class="pent-contact-book">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
                Demo buchen
            </a>
            <p class="pent-contact-book-note">30 Minuten Erstgespräch mit unserem Team</p>
        </header>

        <div class="pent-contact-divider">
            <span class="pent-contact-divider-line"></span>
            <span class="pent-contact-divider-text">Oder schreiben Sie uns</span>
            <span class="pent-contact-divider-line"></span>
        </div>

        <form id="contact-form" class="pent-contact-form" action="https://formspree.io/f/meoyrzog" method="POST">
            <input type="text" name="gotcha" class="hidden" autocomplete="off" tabindex="-1" aria-hidden="true">

            <div class="pent-contact-field-row">
                <div class="pent-contact-field">
                    <label class="pent-contact-label" for="contact-name">Name</label>
                    <input type="text" id="contact-name" name="name" required placeholder="Vor- und Nachname" class="pent-contact-input">
                </div>
                <div class="pent-contact-field">
                    <label class="pent-contact-label" for="contact-email">Geschäftliche E-Mail</label>
                    <input type="email" id="contact-email" name="email" required placeholder="name@unternehmen.de" class="pent-contact-input">
                </div>
            </div>

            <div class="pent-contact-field">
                <label class="pent-contact-label" for="contact-company">Unternehmen</label>
                <input type="text" id="contact-company" name="company" placeholder="Organisation" class="pent-contact-input">
            </div>

            <div class="pent-contact-field">
                <label class="pent-contact-label" for="contact-message">Nachricht</label>
                <textarea id="contact-message" name="message" rows="4" required placeholder="Ihre Nachricht…" class="pent-contact-textarea"></textarea>
            </div>

            <button type="submit" class="pent-contact-submit" data-submit-button>
                <span data-submit-text>Nachricht senden</span>
            </button>
        </form>
    </div>
</section>

<div id="thankyou-overlay" class="pent-thankyou-overlay" role="dialog" aria-modal="true" aria-labelledby="thankyou-title">
