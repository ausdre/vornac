      "name": "Resilience testing for KRITIS and essential services",
      "serviceType": "Penetration Testing for Critical Infrastructure",
      "description": "Continuous penetration testing for KRITIS operators and essential service providers. BSI-aligned validation for energy, transport, healthcare, and OT/IT estates.",
      "provider": { "@id": "https://www.vornac.com/#organization" },
      "areaServed": [
        { "@type": "Country", "name": "Germany" },
        { "@type": "Country", "name": "Austria" },
