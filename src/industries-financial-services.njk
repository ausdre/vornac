---
{% extends "layouts/base.njk" %}

{% block extraHead %}
<link rel="stylesheet" href="/industries.css">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "{{ pageUrls['industries-financial-services'] | absoluteUrl(site.domain) }}#service",
      "name": "Continuous validation for banks and financial institutions",
      "serviceType": "Penetration Testing for Financial Services",
      "description": "Continuous penetration testing for banks, payment institutions, and asset managers. DORA resilience plus BaFin VAIT and BAIT depth, audit-ready for both.",
      "provider": { "@id": "https://www.vornac.com/#organization" },
      "areaServed": [
        { "@type": "Country", "name": "Germany" },
        { "@type": "Country", "name": "Austria" },
        { "@type": "Country", "name": "Switzerland" },
        { "@type": "Place", "name": "European Union" }
      ],
      "audience": {
        "@type": "BusinessAudience",
        "audienceType": "Banks, payment institutions, asset managers, and financial services institutions"
      },
      "category": "Cybersecurity / Financial Services",
      "url": "{{ pageUrls['industries-financial-services'] | absoluteUrl(site.domain) }}",
      "about": [
        { "@type": "Thing", "name": "Digital Operational Resilience Act (DORA)" },
        { "@type": "Thing", "name": "BaFin VAIT" },
        { "@type": "Thing", "name": "BaFin BAIT" },
        { "@type": "Thing", "name": "Threat-Led Penetration Testing (TLPT)" }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ pageUrls.index | absoluteUrl(site.domain) }}" },
        { "@type": "ListItem", "position": 2, "name": "Industries", "item": "{{ pageUrls['industries'] | absoluteUrl(site.domain) }}" },
        { "@type": "ListItem", "position": 3, "name": "Financial Services", "item": "{{ pageUrls['industries-financial-services'] | absoluteUrl(site.domain) }}" }
      ]
    }
  ]
}
</script>
{% endblock %}

{% block content %}
<main class="ind-page">
    <section class="ind-hero">
        <div class="ind-hero-inner">
            <p class="ind-hero-breadcrumb"><a href="{{ pageUrls.industries }}">Industries</a> / Financial services</p>
            <span class="ind-hero-framework">DORA · VAIT · BAIT</span>
            <h1 class="ind-hero-headline">Continuous validation for <span class="ind-hero-headline-emph">banks and financial institutions</span></h1>
            <p class="ind-hero-sub">DORA sets the EU-wide bar for operational resilience. VAIT and BAIT set the German bar for IT and outsourcing on top. VORNAC delivers exploit-proven findings, audit-ready for both supervisors, on every release, anytime.</p>
            <div class="ind-hero-actions">
                {% include "partials/hero-demo-button.njk" %}
                <a href="{{ pageUrls.pentesting }}" class="ind-btn-ghost">How it works</a>
            </div>
        </div>
    </section>

    <section class="ind-section ind-section--cream">
        <div class="ind-section-inner">
            <header class="ind-section-head">
                <h2 class="ind-section-title">What regulators expect</h2>
                <p class="ind-section-lead">Financial entities must demonstrate ICT resilience, outsourcing control, and testing discipline. Under EU and German supervision.</p>
            </header>
            <div class="ind-req-grid">
                <article class="ind-req-card"><h3 class="ind-req-card-title">DORA operational resilience</h3><p class="ind-req-card-desc">ICT risk management, incident classification, resilience testing including TLPT on critical systems.</p></article>
                <article class="ind-req-card"><h3 class="ind-req-card-title">BaFin VAIT (insurance groups)</h3><p class="ind-req-card-desc">IT governance, information security, and continuity requirements for supervised insurance groups where applicable.</p></article>
                <article class="ind-req-card"><h3 class="ind-req-card-title">BaFin BAIT (banks)</h3><p class="ind-req-card-desc">IT systems, information security, and outsourcing requirements for credit institutions and financial services institutions.</p></article>
                <article class="ind-req-card"><h3 class="ind-req-card-title">Outsourcing &amp; cloud</h3><p class="ind-req-card-desc">Critical and important functions. Contractual, monitoring, and exit requirements for ICT service providers.</p></article>
            </div>
        </div>
    </section>

    <section class="ind-gap-band">
        <div class="ind-gap-inner">
            <div>
                <h2 class="ind-gap-title">Supervisors want evidence. Not slides.</h2>
                <p class="ind-gap-text">Annual pentest PDFs don't sit well with BaFin or the ECB. Especially when core banking, payment rails, and trading interfaces change weekly. Continuous validation closes the gap.</p>
            </div>
            <div class="ind-gap-stat">
                <div class="ind-gap-stat-num">100%</div>
                <p class="ind-gap-stat-label">Reports accepted on first auditor pass. Audit-ready for your frameworks.</p>
            </div>
        </div>
    </section>

    <section class="ind-section ind-section--dark">
        <div class="ind-section-inner">
            <header class="ind-section-head ind-section-head--light"><h2 class="ind-section-title">How VORNAC helps</h2></header>
            <ul class="ind-help-list">
                <li class="ind-help-item"><span class="ind-help-num">1</span><div><h3 class="ind-help-title">Audit-ready for multiple frameworks</h3><p class="ind-help-desc">DORA, VAIT, BAIT, NIS2, TISAX where relevant. One finding, one report, multiple audits.</p></div></li>
                <li class="ind-help-item"><span class="ind-help-num">2</span><div><h3 class="ind-help-title">Production-safe adversarial testing</h3><p class="ind-help-desc">No maintenance windows for validating your external attack surface. Real on-demand pentesting without the wait.</p></div></li>
                <li class="ind-help-item"><span class="ind-help-num">3</span><div><h3 class="ind-help-title">German jurisdiction by default</h3><p class="ind-help-desc">Hosted in German data centres run by German providers. No US Cloud Act exposure for supervisory data and findings.</p></div></li>
            </ul>
        </div>
    </section>

    <section class="ind-related">
        <div class="ind-related-inner">
            <p class="ind-related-title">Also relevant</p>
            <div class="ind-related-links">
                <a href="{{ pageUrls['industries-insurance'] }}" class="ind-related-link">Insurance (DORA)</a>
                <a href="{{ pageUrls['industries-enterprise'] }}" class="ind-related-link">Enterprise (NIS2)</a>
                <a href="{{ pageUrls.pentesting }}" class="ind-related-link">VORNAC Pentesting</a>
            </div>
        </div>
    </section>

    <section class="ind-cta">
        <div class="ind-cta-inner">
            <h2 class="ind-cta-headline">One validation cycle. <em>Every framework your auditors ask for.</em></h2>
            <p class="ind-cta-sub">30 minutes. We map your financial ICT landscape to a continuous, audit-ready testing cycle.</p>
            <div class="ind-cta-actions">
                {% include "partials/hero-demo-button.njk" %}
            </div>
        </div>
    </section>
</main>
{% endblock %}
