    {
      "@type": "FAQPage",
      "@id": "https://www.vornac.com/de/wissen/nis2-wirksamkeitspruefung#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Verlangt NIS2 einen Penetrationstest?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Das BSIG schreibt keinen Penetrationstest namentlich vor. § 30 Abs. 2 Satz 2 Nr. 5 verlangt Schwachstellenmanagement, Nr. 6 verlangt Konzepte und Verfahren zur Bewertung der Wirksamkeit der Risikomanagementmaßnahmen. Ein Penetrationstest ist der gängige technische Nachweis dafür, dass Maßnahmen einem realen Angriff standhalten."
          }
        },
        {
          "@type": "Question",
          "name": "Wie oft muss die Wirksamkeit bewertet werden?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Das BSI beschreibt die Wirksamkeitsbewertung als fortlaufenden Prozess, nicht als einmaliges Ereignis. Eine feste Frist nennt das Gesetz nicht; die Bewertung muss zum Risiko und zur Änderungsrate der Systeme passen."
          }
        }
      ]
    },
