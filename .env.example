# Attio -> Google Kalender (api/attio-calendar-webhook.js)
# Werte in Vercel unter Project Settings > Environment Variables setzen.

# Attio: API-Token mit den Scopes task:read, record_permission:read,
# object_configuration:read, user_management:read
ATTIO_API_TOKEN=
# Attio: Secret des Webhooks (wird beim Anlegen des Webhooks angezeigt)
ATTIO_WEBHOOK_SECRET=
# Optional: nur Tasks synchronisieren, deren Text so beginnt (z. B. "Termin:")
ATTIO_TASK_PREFIX=
# Erledigte Tasks: keep (Titel bekommt ein Haekchen) oder delete
ATTIO_COMPLETED_TASKS=keep

# Google: kompletter Inhalt der Service-Account-Schluesseldatei (JSON, eine Zeile)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Google: Ziel-Kalender-ID, z. B. andre@vornac.com oder abc123@group.calendar.google.com
GOOGLE_CALENDAR_ID=
# Optional, nur mit domain-weiter Delegation: Nutzer, in dessen Namen geschrieben
# wird, oder "assignee" fuer den jeweils Verantwortlichen der Task
GOOGLE_IMPERSONATE_USER=
# Optional, nur mit Delegation: Domains, deren Adressen als Teilnehmer eingetragen werden
EVENT_ATTENDEE_DOMAINS=vornac.com

# Termin-Darstellung
EVENT_TIMEZONE=Europe/Berlin
EVENT_DURATION_MINUTES=60
# Deadline ohne Uhrzeit als ganztaegigen Termin anlegen (false: 09:00 Uhr)
EVENT_ALL_DAY_WITHOUT_TIME=true
