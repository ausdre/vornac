{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "vornac.com" }],
      "destination": "https://www.vornac.com/:path*",
      "permanent": true
    },
    {
      "source": "/de",
      "has": [{ "type": "host", "value": "vornac.de" }],
      "destination": "https://www.vornac.com/",
      "permanent": true
    },
    {
      "source": "/de/:path*",
      "has": [{ "type": "host", "value": "vornac.de" }],
      "destination": "https://www.vornac.com/:path*",
      "permanent": true
    },
    {
      "source": "/de",
      "has": [{ "type": "host", "value": "www.vornac.de" }],
      "destination": "https://www.vornac.com/",
      "permanent": true
    },
    {
      "source": "/de/:path*",
      "has": [{ "type": "host", "value": "www.vornac.de" }],
      "destination": "https://www.vornac.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "vornac.de" }],
      "destination": "https://www.vornac.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.vornac.de" }],
      "destination": "https://www.vornac.com/:path*",
      "permanent": true
    },

    { "source": "/de",          "destination": "/",        "permanent": true },
    { "source": "/de/:path*",   "destination": "/:path*",  "permanent": true },

    { "source": "/index.html",     "destination": "/en", "permanent": true },
    { "source": "/index",          "destination": "/en", "permanent": true },
    { "source": "/index_de.html",  "destination": "/",   "permanent": true },
    { "source": "/index_de",       "destination": "/",   "permanent": true },

    { "source": "/pentesting.html",     "destination": "/en/pentesting",     "permanent": true },
    { "source": "/pentesting_de.html",  "destination": "/pentesting",  "permanent": true },
    { "source": "/pentesting_de",       "destination": "/pentesting",  "permanent": true },

    { "source": "/about.html",     "destination": "/en/about",     "permanent": true },
    { "source": "/about_de.html",  "destination": "/about",  "permanent": true },
    { "source": "/about_de",       "destination": "/about",  "permanent": true },

    { "source": "/customers.html",     "destination": "/en/customers",     "permanent": true },
    { "source": "/customers_de.html",  "destination": "/customers",  "permanent": true },
    { "source": "/customers_de",       "destination": "/customers",  "permanent": true },

    { "source": "/apply.html",     "destination": "/en/apply",     "permanent": true },
    { "source": "/apply_de.html",  "destination": "/apply",  "permanent": true },
    { "source": "/apply_de",       "destination": "/apply",  "permanent": true },

    { "source": "/legal.html",     "destination": "/en/legal",     "permanent": true },
    { "source": "/legal_de.html",  "destination": "/legal",  "permanent": true },
    { "source": "/legal_de",       "destination": "/legal",  "permanent": true },
    { "source": "/privacy.html",   "destination": "/en/legal",     "permanent": true },
    { "source": "/privacy",        "destination": "/en/legal",  "permanent": true },
    { "source": "/privacy_de.html","destination": "/legal",     "permanent": true },
    { "source": "/privacy_de",     "destination": "/legal",  "permanent": true },

    { "source": "/industries.html",     "destination": "/en/industries",     "permanent": true },
    { "source": "/industries_de.html",  "destination": "/industries",  "permanent": true },
    { "source": "/industries_de",       "destination": "/industries",  "permanent": true },

    { "source": "/industries-automotive.html",                "destination": "/en/industries-automotive",                "permanent": true },
    { "source": "/industries-automotive_de.html",             "destination": "/industries-automotive",             "permanent": true },
    { "source": "/industries-automotive_de",                  "destination": "/industries-automotive",             "permanent": true },

    { "source": "/industries-critical-infrastructure.html",    "destination": "/en/industries-critical-infrastructure",    "permanent": true },
    { "source": "/industries-critical-infrastructure_de.html", "destination": "/industries-critical-infrastructure", "permanent": true },
    { "source": "/industries-critical-infrastructure_de",      "destination": "/industries-critical-infrastructure", "permanent": true },

    { "source": "/industries-enterprise.html",                "destination": "/en/industries-enterprise",                "permanent": true },
    { "source": "/industries-enterprise_de.html",             "destination": "/industries-enterprise",             "permanent": true },
    { "source": "/industries-enterprise_de",                  "destination": "/industries-enterprise",             "permanent": true },

    { "source": "/industries-financial-services.html",        "destination": "/en/industries-financial-services",        "permanent": true },
    { "source": "/industries-financial-services_de.html",     "destination": "/industries-financial-services",     "permanent": true },
    { "source": "/industries-financial-services_de",          "destination": "/industries-financial-services",     "permanent": true },

    { "source": "/industries-insurance.html",                 "destination": "/en/industries-insurance",                 "permanent": true },
    { "source": "/industries-insurance_de.html",              "destination": "/industries-insurance",              "permanent": true },
    { "source": "/industries-insurance_de",                   "destination": "/industries-insurance",              "permanent": true },

    { "source": "/comcenter.html",    "destination": "/en/comcenter", "permanent": true },
    { "source": "/comcenter",         "destination": "/en/comcenter", "permanent": true },

    { "source": "/preventive.html",        "destination": "/en", "permanent": true },
    { "source": "/preventive",             "destination": "/en", "permanent": true },
    { "source": "/preventive_de.html",     "destination": "/",   "permanent": true },
    { "source": "/preventive_de",          "destination": "/",   "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|svg|gif|ico|avif)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.(woff|woff2|ttf|otf|eot)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(pdf|MP4|mp4|webm)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    }
  ]
}
